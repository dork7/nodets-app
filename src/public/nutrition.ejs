<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Nutrition Report</title>
<style>
  :root {
    --bg:            #0a0a0a;
    --bg-raised:     #121212;
    --bg-inset:      #1a1a1a;
    --border:        #262626;
    --border-strong: #333333;
    --fg:            #ededed;
    --fg-muted:      #8f8f8f;
    --fg-faint:      #5c5c5c;
    --accent:        #fafafa;
    --on-accent:     #0a0a0a;
    --success:       #3fb950;
    --warn:          #d29922;
    --danger:        #f85149;
    --info:          #58a6ff;
    --font-mono: "Geist Mono","Berkeley Mono","JetBrains Mono",ui-monospace,"SF Mono","Cascadia Code","Roboto Mono",Menlo,Consolas,monospace;
    --font-sans: "Geist",ui-sans-serif,-apple-system,"Segoe UI",Roboto,sans-serif;
    --radius:    6px;
    --radius-sm: 4px;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-mono);
    -webkit-font-smoothing: antialiased;
  }

  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 24px;
    height: 48px;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .wordmark-mark {
    width: 14px;
    height: 14px;
    background: var(--accent);
    border-radius: 3px;
  }

  .topbar-meta {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
  }

  main { max-width: 960px; margin: 0 auto; padding: 40px 24px 64px; }

  .caption {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
  }

  h1 {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 6px 0 0;
  }

  .meta-line {
    margin-top: 8px;
    font-size: 11px;
    color: var(--fg-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .rule { border: 0; border-top: 1px solid var(--border); margin: 20px 0 28px; }

  .btn-primary {
    background: var(--accent);
    color: var(--on-accent);
    border: 1px solid var(--accent);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 9px 16px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .btn-primary:hover { opacity: 0.92; }

  .btn-ghost {
    display: inline-block;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 9px 16px;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .btn-ghost:hover { background: var(--bg-inset); border-color: var(--border-strong); }

  .upload {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    margin-bottom: 28px;
  }

  .upload-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
    color: var(--fg-faint);
    display: block;
    margin-bottom: 12px;
  }

  .upload form {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .file-wrap { display: inline-block; }

  .file-wrap input[type="file"] {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .file-wrap input[type="file"]:focus-visible + .btn-ghost {
    outline: 1px solid var(--accent);
    outline-offset: 2px;
  }

  .hint { font-size: 11px; color: var(--fg-faint); margin: 12px 0 0; }

  .error {
    border: 1px solid var(--danger);
    background: var(--bg-raised);
    border-radius: var(--radius);
    padding: 14px 16px;
    margin-bottom: 24px;
    font-size: 13px;
    color: var(--danger);
  }

  .section-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
    margin: 0 0 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .section-title .index { color: var(--fg-faint); }
  .section-title .name { color: var(--fg); }
  .section-title .pipe { color: var(--border-strong); }
  .section-title .dim { color: var(--fg-faint); font-size: 11px; letter-spacing: 0.04em; text-transform: none; }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
    margin-bottom: 28px;
  }

  .stat {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 16px;
  }

  .stat-label {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
    color: var(--fg-faint);
  }

  .stat-value {
    font-size: 30px;
    font-variant-numeric: tabular-nums;
    margin-top: 8px;
    line-height: 1;
  }

  .stat-unit { font-size: 13px; color: var(--fg-muted); }

  .stat-sub { font-size: 12px; color: var(--fg-muted); margin-top: 4px; }

  .figure-caption {
    font-size: 11px;
    color: var(--fg-faint);
    margin-bottom: 8px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-bottom: 28px;
  }

  thead tr { background: var(--bg-inset); }

  th {
    text-align: left;
    padding: 8px 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 11px;
    color: var(--fg-faint);
    font-weight: 500;
  }

  th.num, td.num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  tbody tr { border-bottom: 1px solid var(--border); }
  tbody tr:hover { background: var(--bg-inset); }

  td { padding: 10px 12px; }
  td.item { color: var(--fg); }
  td.qty { color: var(--fg-muted); }
  td.num { color: var(--fg-muted); }
  td.num strong { color: var(--fg); font-weight: 500; }

  .bars { margin-bottom: 28px; }

  .bar-row { margin-bottom: 14px; }

  .bar-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 12px;
    margin-bottom: 6px;
  }

  .bar-name { color: var(--fg); }

  .bar-pct {
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .track {
    height: 6px;
    background: var(--bg-inset);
    border-radius: 3px;
    overflow: hidden;
  }

  .fill { height: 100%; background: var(--accent); }
  .fill.success { background: var(--success); }

  .footnote {
    border-top: 1px solid var(--border);
    padding-top: 14px;
    font-size: 11px;
    color: var(--fg-faint);
    line-height: 1.6;
    max-width: 72ch;
  }

  .footnote strong { color: var(--fg-muted); font-weight: 500; }

  @media (max-width: 640px) {
    main { padding: 24px 16px 48px; }
    .topbar { padding: 0 16px; }
    .topbar-meta { display: none; }
  }
</style>
</head>
<body>
  <header class="topbar">
    <div class="wordmark">
      <span class="wordmark-mark" aria-hidden="true"></span>
      NUTRITION&nbsp;AI
    </div>
    <div class="topbar-meta">Vision analysis · estimate</div>
  </header>

  <main>
    <div class="caption">Meal analysis · AI estimate</div>
    <h1>Nutrition Report</h1>
    <div class="meta-line">Fig 00 · Estimates from visual inspection</div>
    <hr class="rule" />

    <% if (error) { %>
      <div class="error" role="alert"><%= error %></div>
    <% } %>

    <section class="upload" aria-label="Analyze an image">
      <label class="upload-label" for="image">Input · meal image</label>
      <form method="post" enctype="multipart/form-data" action="/v1/nutrition">
        <span class="file-wrap">
          <input id="image" name="image" type="file" accept="image/*" required />
          <span class="btn-ghost" aria-hidden="true">Select image…</span>
        </span>
        <span class="file-wrap">
          <input id="prompt" name="prompt" type="hidden" value="<%= prompt || '' %>" />
          <button class="btn-primary" type="submit">Analyze</button>
        </span>
      </form>
      <p class="hint">PNG / JPEG · max 5 MB · values are AI estimates</p>
    </section>

    <% if (hasReport) { %>
      <h2 class="section-title"><span class="index">01</span><span class="pipe">/</span><span class="name">Totals</span></h2>
      <section class="stats" aria-label="Meal totals">
        <div class="stat">
          <div class="stat-label">Calories</div>
          <div class="stat-value"><%= totals.calories %> <span class="stat-unit">kcal</span></div>
          <div class="stat-sub"><%= items.length %> items identified</div>
        </div>
        <div class="stat">
          <div class="stat-label">Protein</div>
          <div class="stat-value"><%= totals.protein %> <span class="stat-unit">g</span></div>
        </div>
        <div class="stat">
          <div class="stat-label">Fat</div>
          <div class="stat-value"><%= totals.fat %> <span class="stat-unit">g</span></div>
        </div>
        <div class="stat">
          <div class="stat-label">Carbs</div>
          <div class="stat-value"><%= totals.carbs %> <span class="stat-unit">g</span></div>
        </div>
      </section>

      <div class="figure-caption">
        <span>Fig 1. Ingredient breakdown</span>
        <span><%= items.length %> records</span>
      </div>

      <table>
        <caption style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;">
          Estimated nutritional breakdown of identified ingredients
        </caption>
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Est. qty</th>
            <th scope="col" class="num">Calories</th>
            <th scope="col" class="num">Protein (g)</th>
            <th scope="col" class="num">Fat (g)</th>
            <th scope="col" class="num">Carbs (g)</th>
            <th scope="col" class="num">Fiber (g)</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function (item) { %>
            <tr>
              <td class="item"><%= item.food_item %></td>
              <td class="qty"><%= item.estimated_quantity || '—' %></td>
              <td class="num"><strong><%= fmtNum(item.calories) %></strong></td>
              <td class="num"><%= fmtNum(item.protein_g) %></td>
              <td class="num"><%= fmtNum(item.fat_g) %></td>
              <td class="num"><%= fmtNum(item.carbohydrates_g) %></td>
              <td class="num"><%= fmtNum(item.fiber_g) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>

      <h2 class="section-title">
        <span class="index">02</span><span class="pipe">/</span><span class="name">Calorie share</span>
        <span class="dim">share of each item vs. total</span>
      </h2>
      <section class="bars" aria-label="Calorie share by item">
        <% items.forEach(function (item) { %>
          <div class="bar-row">
            <div class="bar-head">
              <span class="bar-name"><%= item.food_item %></span>
              <span class="bar-pct"><%= shareOf(item.calories) %>% · <%= fmtNum(item.calories) %> kcal</span>
            </div>
            <div class="track" role="img" aria-label="<%= item.food_item %>: <%= shareOf(item.calories) %>% of calories">
              <div class="fill <%= item.calories >= totalCal ? 'success' : '' %>" style="width:<%= Math.min(shareOf(item.calories), 100) %>%"></div>
            </div>
          </div>
        <% }); %>
      </section>

      <div class="footnote">
        <strong>Disclaimer</strong> —
        This is an AI-generated estimation based on visual analysis.
        Actual nutritional values may vary significantly depending on the exact
        weight of ingredients and the amount of oil used during cooking.
        <%= disclaimer %>
      </div>
    <% } %>
  </main>
</body>
</html>