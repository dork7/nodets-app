    async ingestAll() {
     const pending = this.files.filter((f) => !f.ingested);
     if (pending.length === 0) {
      messageManager.append('System', 'All uploaded files are already ingested.', 'system');
      return;
     }

     this.setActionButtonsBusy('.js-rag-ingest-all', true, 'Ingesting...');
     let ok = 0;
     let failed = 0;
     for (const file of pending) {
      try {
       const res = await fetch(CONFIG.RAG_INGEST_API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
         source: 'minio',
         fileId: file.id,
         bucket: CONFIG.RAG_BUCKET,
         provider: state.selectedProvider || undefined,
        }),
       });
       const result = await res.json();
       if (result.success) {
        ok += 1;
       } else {
        failed += 1;
        console.error(`Ingest failed for "${this.displayName(file)}":`, result.message);
       }
      } catch (error) {
       failed += 1;
       console.error(`Ingest error for "${this.displayName(file)}":`, error);
      }
     }
     this.setActionButtonsBusy('.js-rag-ingest-all', false);

     messageManager.append(
      'System',
      `Ingested ${ok} file${ok === 1 ? '' : 's'}${failed > 0 ? `, ${failed} failed (see console)` : ''}.`,
      'system'
     );
     await this.loadFiles();
    },

    bindDragDrop(element, highlightEl) {
     if (!element || !highlightEl) return;
     let depth = 0;

     element.addEventListener('dragenter', (e) => {
      e.preventDefault();
      depth += 1;
      highlightEl.classList.add('dragover');
     });

     element.addEventListener('dragover', (e) => e.preventDefault());

     element.addEventListener('dragleave', () => {
      depth = Math.max(0, depth - 1);
      if (depth === 0) {
       highlightEl.classList.remove('dragover');
      }
     });

     element.addEventListener('drop', (e) => {
      e.preventDefault();
      depth = 0;
      highlightEl.classList.remove('dragover');
      const files = e.dataTransfer && e.dataTransfer.files ? Array.from(e.dataTransfer.files) : [];
      if (files.length > 0) {
       this.uploadFiles(files);
      }
     });
    },

    init() {
     elements.ragViewAllBtn?.addEventListener('click', () => {
      this.loadFiles();
      this.openModal();
     });

     elements.ragFilesModalClose?.addEventListener('click', () => this.closeModal());

     elements.ragFilesModal?.addEventListener('click', (e) => {
      if (e.target === elements.ragFilesModal) {
       this.closeModal();
      }
     });

     document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && elements.ragFilesModal && !elements.ragFilesModal.hidden) {
       this.closeModal();
      }
     });

     elements.ragFilesUploadBtn?.addEventListener('click', () => this.uploadSelected());

     elements.ragFilesDeleteAllBtn?.addEventListener('click', () => this.deleteAllFiles());

     document.querySelectorAll('.js-rag-clear-ingestions').forEach((btn) =>
      btn.addEventListener('click', () => this.clearAllIngestions())
     );

     document.querySelectorAll('.js-rag-ingest-all').forEach((btn) =>
      btn.addEventListener('click', () => this.ingestAll())
     );

     this.bindDragDrop(elements.ragFilesModal, elements.ragFilesDialog);
     this.bindDragDrop(elements.ragPanel, elements.ragPanel);

     this.loadFiles();
    },
   };

   // ===== Google account / Drive connection =====
   const googleAuthManager = {
    elements: {
     wrapper: document.getElementById('google-auth-status'),
     signInLink: document.getElementById('google-signin-link'),
     connectDriveLink: document.getElementById('google-connect-drive-link'),
     accountInfo: document.getElementById('google-account-info'),
     disconnectBtn: document.getElementById('google-disconnect-btn'),
    },

    async refresh() {
     const { wrapper, signInLink, connectDriveLink, accountInfo, disconnectBtn } = this.elements;
     try {
      const res = await fetch('/v1/auth/status', { credentials: 'same-origin' });
      const status = await res.json();

      wrapper.hidden = false;
      signInLink.hidden = status.authenticated;
      connectDriveLink.hidden = !status.authenticated || status.driveConnected;
      accountInfo.hidden = !status.authenticated;
      disconnectBtn.hidden = !status.authenticated || !status.driveConnected;

      if (status.authenticated) {
       accountInfo.textContent = status.driveConnected
        ? `${status.email} · Drive connected`
        : status.email;
      }
     } catch (err) {
      console.error('Failed to load Google auth status:', err);
     }
    },

    init() {
     this.elements.disconnectBtn.addEventListener('click', async () => {
      try {
       await fetch('/v1/auth/disconnect-drive', { method: 'POST', credentials: 'same-origin' });
      } finally {
       this.refresh();
      }
     });
     this.refresh();
    },
   };

   // ===== Initialization =====
   document.addEventListener('DOMContentLoaded', () => {
    localStorage.setItem('chatSessionId', state.sessionId);
    document.title = `ChatAI Session | ${state.sessionId}`;

    streamingToggle.init();
    ragToggle.init();
    providerManager.init();
    providerManager.loadProviders();
    formHandler.init();
    ttsManager.init();
    uploadManager.init();
    codePreviewManager.init();
    historyManager.init();
    historyManager.initConfirmModal();
    modelManager.init();
    modelManager.loadModels();
    totalTokenUsageManager.load();
    websocketManager.connect();
    newChatManager.init();
    ragManager.init();
    googleAuthManager.init();
   });

  </script>
 </body>
</html>
