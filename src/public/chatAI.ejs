      <button type="button" class="model-sheet-close" id="model-sheet-close" aria-label="Close">×</button>
     </div>
     <div class="model-sheet-body" id="model-sheet-body"></div>
    </div>
   </div>
   <div id="history-sheet-overlay" hidden>
    <div class="history-sheet" role="dialog" aria-modal="true" aria-labelledby="history-sheet-title">
     <div class="history-sheet-header">
      <span class="history-sheet-title" id="history-sheet-title">Chat History</span>
      <button type="button" class="history-sheet-clear" id="history-sheet-clear" aria-label="Clear chat history">Clear</button>
      <span class="history-sheet-count" id="history-sheet-count"></span>
      <button type="button" class="history-sheet-close" id="history-sheet-close" aria-label="Close">×</button>
     </div>
     <div class="history-sheet-body" id="history-sheet-body"></div>
    </div>
   </div>
  <script nonce="abc123">
   // ===== Configuration =====
   // Derived from the page's own origin so this works both on localhost and
   // when hosted remotely (e.g. Render) — hardcoded localhost:2020 URLs only
   // ever worked when the browser and server were on the same machine.
   const API_ORIGIN = window.location.origin;
   const WS_ORIGIN = (window.location.protocol === 'https:' ? 'wss:' : 'ws:') + '//' + window.location.host;
   const CONFIG = {
    WS_URL: `${WS_ORIGIN}/ws/chatAI`,
    MODELS_API_URL: `${API_ORIGIN}/chatModels`,
    PROVIDERS_API_URL: `${API_ORIGIN}/v1/aiProviders`,
    HISTORY_API_URL: `${API_ORIGIN}/v1/aiUtils/chat-history`,
    RAG_FILES_API_URL: `${API_ORIGIN}/v1/minio/files`,
    RAG_INGEST_API_URL: `${API_ORIGIN}/v1/rag/ingest`,
    RAG_API_URL: `${API_ORIGIN}/v1/rag`,
    RAG_BUCKET: 'rag-files',
    TOTAL_TOKEN_USAGE_API_URL: `${API_ORIGIN}/v1/aiUtils/total-token-usage`,
    LOADED_MODELS_API_URL: `${API_ORIGIN}/v1/aiUtils/loaded-models`,
    UNLOAD_MODEL_API_URL: `${API_ORIGIN}/v1/aiUtils/unload-model`,
    TTS_API_URL: `${API_ORIGIN}/v1/aiUtils/text-to-speech`,
    UPLOAD_API_URL: `${API_ORIGIN}/v1/minio/upload`,
    MAX_FILE_SIZE: 10 * 1024 * 1024,
    MAX_FILES: 6,
    RECONNECT_DELAY: 5000,
    DEFAULT_MODEL_INDEX: 1,
    DEFAULT_MODEL: 'lfm2.5-1.2b-instruct',
    LOADING_MESSAGES: [
     'Loading...',
     'Panicking...',
     'Thinking...',
     'Almost there...',
     'Connecting neurons...',
     'Generating chaos...',
     'One sec...',
     'Sabar karo, ruko zara...',
     'Feeding the model...',
     'Loading brain juice...',
     'Doing model stuff...',
    ],
   };
   document.getElementById('app-header-ws-meta').textContent = CONFIG.WS_URL;

// ===== State Management =====
const state = {
    selectedModel: localStorage.getItem('chatSelectedModel') || '',
    selectedProvider: localStorage.getItem('chatSelectedProvider') || '',
    defaultModel: localStorage.getItem('chatDefaultModel') || '',
    streamingEnabled: localStorage.getItem('chatStreaming') !== 'false',
    ragEnabled: localStorage.getItem('chatRAG') !== 'false',
    ragDistance: localStorage.getItem('chatRAGDistance') || '',
    isStreaming: false,
    isConnected: false,
    ragStreaming: localStorage.getItem('chatRagStreaming') !== 'false',
    currentIsRelated: false,
    currentRagSources: [],
    combinedContent: '',
    streamStartTime: 0,
    requestStartTime: null,
    requestEndTime: null,
    lastTokensPerSecond: 0,
    streamMessageCount: 0,
    socket: null,
    pendingFiles: [],
    pastedCodeList: [],
    loadedModelsByName: {},
    allModels: [],
    modelSearchQuery: '',
    sessionId: localStorage.getItem('chatSessionId') || `sess-${Math.random().toString(36).substr(2, 9)}`,
};

   // ===== DOM Elements =====
   const elements = {
    messages: document.getElementById('messages'),
    tokenUsageHeaderValues: document.getElementById('token-usage-header-values'),
    form: document.getElementById('input-form'),
    input: document.getElementById('input'),
    speakBtn: document.getElementById('speak-btn'),
    sendBtn: document.getElementById('send'),
    stopBtn: document.getElementById('stop-stream'),
    streamToggle: document.getElementById('stream-toggle'),
    streamingLabel: document.getElementById('streaming-label'),
    ragToggle: document.getElementById('rag-toggle'),
    ragLabel: document.getElementById('rag-label'),
    ragDistance: document.getElementById('rag-distance'),
    ragDistanceContainer: document.getElementById('rag-distance-container'),
    modelSelector: document.getElementById('model-selector'),
    modelSearchInput: document.getElementById('model-search-input'),
    providerSelector: document.getElementById('provider-selector'),
    uploadBtn: document.getElementById('upload-btn'),
    fileInput: document.getElementById('file-input'),
    inputAttachments: document.getElementById('input-attachments'),
    codePreview: document.getElementById('code-preview'),
    dropOverlay: document.getElementById('drop-overlay'),
    chatContainer: document.getElementById('chat-container'),
    historyPanel: document.getElementById('history-panel'),
    historyContent: document.getElementById('history-content'),
    historyViewAllBtn: document.getElementById('history-view-all-btn'),
    clearHistoryBtn: document.getElementById('clear-history-btn'),
    historySheetOverlay: document.getElementById('history-sheet-overlay'),
    historySheetBody: document.getElementById('history-sheet-body'),
    historySheetClose: document.getElementById('history-sheet-close'),
    historySheetCount: document.getElementById('history-sheet-count'),
    historySheetClearBtn: document.getElementById('history-sheet-clear'),
    ragPanel: document.getElementById('rag-panel'),
    ragContent: document.getElementById('rag-content'),
    ragViewAllBtn: document.getElementById('rag-view-all-btn'),
    ragFilesModal: document.getElementById('rag-files-modal'),
    ragFilesDialog: document.querySelector('.rag-files-dialog'),
    ragFilesModalClose: document.getElementById('rag-files-modal-close'),
    ragFilesModalCount: document.getElementById('rag-files-modal-count'),
    ragFileInput: document.getElementById('rag-file-input'),
    ragFilesUploadBtn: document.getElementById('rag-files-upload-btn'),
    ragFilesDeleteAllBtn: document.getElementById('rag-files-delete-all-btn'),
    ragFilesList: document.getElementById('rag-files-list'),
    newChatBtn: document.getElementById('new-chat-btn'),
    confirmModal: document.getElementById('confirm-modal'),
    confirmModalTitle: document.getElementById('confirm-modal-title'),
    confirmModalBody: document.getElementById('confirm-modal-body'),
    confirmModalClose: document.getElementById('confirm-modal-close'),
    confirmModalYes: document.getElementById('confirm-modal-yes'),
    confirmModalNo: document.getElementById('confirm-modal-no'),
    modelViewAllBtn: document.getElementById('model-view-all-btn'),
    modelSheetOverlay: document.getElementById('model-sheet-overlay'),
    modelSheetBody: document.getElementById('model-sheet-body'),
    modelSheetClose: document.getElementById('model-sheet-close'),
    modelSheetCount: document.getElementById('model-sheet-count'),
   };

   // ===== Utility Functions =====
   const utils = {
    parseMarkdown(text) {
     return text
      .replace(/(?:__|\*\*)(.*?)\1/g, '<strong>$1</strong>')
      .replace(/(?:_|\*)(.*?)\1/g, '<em>$1</em>')
      .replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>')
      .replace(/\n/g, '<br>');
    },

    scrollToBottom(force = false) {
     const el = elements.messages;
     const distanceFromBottom = el.scrollHeight - el.scrollTop - el.clientHeight;
     if (force || distanceFromBottom < 80) {
      el.scrollTop = el.scrollHeight;
     }
    },

    formatClockTime(timestamp) {
     if (!timestamp) return '—';
     return new Date(timestamp).toLocaleTimeString('en-US', { hour12: false });
    },

    formatDuration(ms) {
     if (!ms && ms !== 0) return '—';
     if (ms < 1000) return `${ms}ms`;
     return `${(ms / 1000).toFixed(2)}s`;
    },

    formatFileSize(bytes) {
     if (bytes == null) return '—';
     if (bytes < 1024) return `${bytes} B`;
     if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
     return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    },

    getLoadingMessage() {
     const index = Math.floor(Math.random() * CONFIG.LOADING_MESSAGES.length);
     return CONFIG.LOADING_MESSAGES[index];
    },

    setStopButtonEnabled(isEnabled) {
     elements.stopBtn.disabled = !isEnabled;
     // A response is in flight exactly while the stop button is active, so the
     // send button is the inverse: blocked until the socket response completes.
     elements.sendBtn.disabled = isEnabled;
    },

    async copyToClipboard(text) {
     if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
     }

     const textarea = document.createElement('textarea');
     textarea.value = text;
     textarea.setAttribute('readonly', '');
     textarea.style.position = 'fixed';
     textarea.style.opacity = '0';
     document.body.appendChild(textarea);
     textarea.select();
     document.execCommand('copy');
     textarea.remove();
    },
   };

   // ===== Message Management =====
   const messageManager = {
    createCopyButton() {
     const button = document.createElement('button');
     button.type = 'button';
     button.className = 'copy-message-btn';
     button.title = 'Copy message';
     button.setAttribute('aria-label', 'Copy message text');
     button.innerHTML = `
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="10" height="10" rx="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"></path>
                    </svg>
                `;
     button.addEventListener('click', async (event) => {
      event.stopPropagation();
      const messageElement = button.closest('.message');
      const textToCopy = messageElement?.dataset.copyText || '';

      try {
       await utils.copyToClipboard(textToCopy);
       button.classList.add('copied');
       button.title = 'Copied';
       button.setAttribute('aria-label', 'Copied message text');
       setTimeout(() => {
        button.classList.remove('copied');
        button.title = 'Copy message';
        button.setAttribute('aria-label', 'Copy message text');
       }, 1200);
      } catch (error) {
       console.error('Unable to copy message:', error);
      }
     });

     return button;
    },

    setCopyText(messageElement, message) {
     messageElement.dataset.copyText = message;
    },

    append(sender, message, type) {
     const div = document.createElement('div');
     div.className = `message ${type}`;
     this.setCopyText(div, message);

     if (type === 'ai') {
      // Create content div first (will be inserted after indicator if it exists)
      const contentDiv = document.createElement('div');
      contentDiv.className = 'message-content';
      const isLoading = CONFIG.LOADING_MESSAGES.includes(message);
      const displayText = isLoading
       ? `<span class="thinking-spinner" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="loading-blink">${utils.parseMarkdown(message)}</span>`
       : utils.parseMarkdown(message);
      contentDiv.innerHTML = `<strong>${sender}:</strong> ${displayText}`;
      div.appendChild(contentDiv);
     } else {
      div.innerHTML = `<strong>${sender}:</strong> ${utils.parseMarkdown(message)}`;
     }

     div.appendChild(this.createCopyButton());

     elements.messages.appendChild(div);
     utils.scrollToBottom();
     return div;
    },

    appendImage(sender, image) {
     const div = document.createElement('div');
     div.className = 'message user';
     div.dataset.copyText = image.url;

     const label = document.createElement('div');
     label.innerHTML = `<strong>${sender}:</strong>`;
     div.appendChild(label);

     const img = document.createElement('img');
     img.className = 'chat-image';
     img.src = image.url;
     img.alt = image.name;
     img.addEventListener('click', () => {
      window.open(image.url, '_blank');
     });

     const imgWrap = document.createElement('div');
     imgWrap.className = 'chat-image-wrap';
     imgWrap.appendChild(img);
     div.appendChild(imgWrap);

     div.appendChild(this.createCopyButton());
     elements.messages.appendChild(div);
     utils.scrollToBottom();
     return div;
    },

    updateLast(sender, message, type) {
     const lastMsg = elements.messages.lastElementChild;
     if (lastMsg && lastMsg.classList.contains(type)) {
      this.setCopyText(lastMsg, message);
      if (type === 'ai') {
       const contentDiv = lastMsg.querySelector('.message-content');
       if (contentDiv) {
        contentDiv.innerHTML = `<strong>${sender}:</strong> ${utils.parseMarkdown(message)}`;
       } else {
        const newContentDiv = document.createElement('div');
        newContentDiv.className = 'message-content';
        newContentDiv.innerHTML = `<strong>${sender}:</strong> ${utils.parseMarkdown(message)}`;
        // Remove old content and add new structure
        const oldContent = lastMsg.childNodes;
        const indicatorSection = lastMsg.querySelector('.related-indicator-section');
        Array.from(oldContent).forEach((node) => {
         if (
          !node.classList ||
          (!node.classList.contains('related-indicator-section') && !node.classList.contains('copy-message-btn'))
         ) {
          node.remove();
         }
        });
        // Insert content after indicator section (if it exists) or at the beginning
        if (indicatorSection) {
         lastMsg.insertBefore(newContentDiv, indicatorSection.nextSibling);
        } else {
         lastMsg.appendChild(newContentDiv);
        }
       }
      } else {
       lastMsg.innerHTML = `<strong>${sender}:</strong> ${utils.parseMarkdown(message)}`;
       lastMsg.appendChild(this.createCopyButton());
      }
      utils.scrollToBottom();
      return lastMsg;
     }
     return null;
    },
   };

   // ===== Related Indicator Management =====
   const indicatorManager = {
    add(messageElement, isRelated) {
     if (!messageElement) return;

     let indicatorSection = messageElement.querySelector('.related-indicator-section');
     if (!indicatorSection) {
      indicatorSection = document.createElement('div');
      indicatorSection.className = 'related-indicator-section';

      const indicator = document.createElement('span');
      indicator.className = 'related-indicator';
      indicatorSection.appendChild(indicator);

      // Insert at the beginning (top) of the message element
      const firstChild = messageElement.firstChild;
      if (firstChild) {
       messageElement.insertBefore(indicatorSection, firstChild);
      } else {
       messageElement.appendChild(indicatorSection);
      }
     }
     this.update(messageElement, isRelated);
    },

    update(messageElement, isRelated) {
     const indicator = messageElement?.querySelector('.related-indicator');
     if (!indicator) return;

     indicator.classList.remove('related', 'unrelated');

     if (isRelated === true) {
      indicator.classList.add('related');
      indicator.textContent = 'Related';
     } else {
      indicator.classList.add('unrelated');
      indicator.textContent = 'Unrelated';
     }
    },
   };

   // ===== RAG Sources Management =====
   const sourcesManager = {
    add(messageElement, sources) {
     if (!messageElement || !Array.isArray(sources) || sources.length === 0) return;

     let section = messageElement.querySelector('.rag-sources-section');
     if (!section) {
      section = document.createElement('div');
      section.className = 'rag-sources-section';
      messageElement.appendChild(section);
     }
     const wasOpen = section.classList.contains('is-open');
     section.innerHTML = '';
     section.classList.toggle('is-open', wasOpen);

     const heading = document.createElement('div');
     heading.className = 'rag-sources-heading';
     const caret = document.createElement('span');
     caret.className = 'rag-sources-caret';
     caret.textContent = '▸';
     heading.appendChild(caret);
     heading.appendChild(document.createTextNode(`Sources (${sources.length})`));
     heading.addEventListener('click', (e) => {
      e.stopPropagation();
      section.classList.toggle('is-open');
     });
     section.appendChild(heading);

     const body = document.createElement('div');
     body.className = 'rag-sources-body';
     section.appendChild(body);

     sources.forEach((s) => {
      const item = document.createElement('div');
      item.className = 'rag-source-item';

      const meta = document.createElement('div');
      meta.className = 'rag-source-meta';
      const score = typeof s.score === 'number' ? `match ${s.score.toFixed(2)}` : 'match';
      meta.textContent = s.source ? `${score} · ${s.source}` : score;
      item.appendChild(meta);

      const text = document.createElement('div');
      text.className = 'rag-source-text';
      const chunk = typeof s.text === 'string' ? s.text : '';
      text.textContent = chunk;
      if (chunk.length > 300) {
       text.classList.add('is-clamped');
      }
      item.appendChild(text);

      item.addEventListener('click', (e) => {
       e.stopPropagation();
       text.classList.toggle('is-clamped');
      });

      body.appendChild(item);
     });
    },
   };

   // ===== Token Usage Management =====
   const tokenUsageManager = {
    add(messageElement, tokenUsage) {
     if (!messageElement) return;

     let usageSection = messageElement.querySelector('.token-usage-section');
     if (!usageSection) {
      usageSection = document.createElement('div');
      usageSection.className = 'token-usage-section';
      messageElement.appendChild(usageSection);
     }
     this.update(messageElement, tokenUsage);
    },

    update(messageElement, tokenUsage) {
     const usageSection = messageElement?.querySelector('.token-usage-section');
     if (!usageSection) return;

     const promptTokens = tokenUsage?.prompt_tokens || 0;
     const completionTokens = tokenUsage?.completion_tokens || 0;
     const totalTokens = tokenUsage?.total_tokens || 0;

      // Always show token usage section for AI messages
      usageSection.innerHTML = `
                    <div class="token-usage">
                        <div class="token-usage-item">
                            <span class="token-usage-label">Speed:</span>
                            <span class="token-usage-value">${state.lastTokensPerSecond > 0 ? `${state.lastTokensPerSecond.toFixed(1)} tok/s` : '—'}</span>
                        </div>
                        <div class="token-usage-item">
                            <span class="token-usage-label">Prompt:</span>
                            <span class="token-usage-value">${promptTokens.toLocaleString()}</span>
                        </div>
                        <div class="token-usage-item">
                            <span class="token-usage-label">Completion:</span>
                            <span class="token-usage-value">${completionTokens.toLocaleString()}</span>
                        </div>
                        <div class="token-usage-item">
                            <span class="token-usage-label">Total:</span>
                            <span class="token-usage-value">${totalTokens.toLocaleString()}</span>
                        </div>
                    </div>
                `;
     usageSection.style.display = 'flex';
    },
   };

   // ===== Request Timing Management =====
   const timingManager = {
    update(messageElement, requestStartTime, requestEndTime) {
     if (!messageElement) return;

     let timingSection = messageElement.querySelector('.timing-section');
     if (!timingSection) {
      timingSection = document.createElement('div');
      timingSection.className = 'timing-section';
      messageElement.appendChild(timingSection);
     }

     const start = requestStartTime || null;
     const end = requestEndTime || Date.now();
     const lastTokenUsage = messageElement.querySelector('.token-usage-section');
     timingSection.classList.toggle('timing-with-token-usage', Boolean(lastTokenUsage));

     timingSection.innerHTML = `
                    <div class="timing">
                        <div class="timing-item">
                            <span class="timing-label">Start:</span>
                            <span class="timing-value">${utils.formatClockTime(start)}</span>
                        </div>
                        <div class="timing-item">
                            <span class="timing-label">End:</span>
                            <span class="timing-value">${utils.formatClockTime(end)}</span>
                        </div>
                        <div class="timing-item">
                            <span class="timing-label">Duration:</span>
                            <span class="timing-value">${utils.formatDuration(start ? end - start : null)}</span>
                        </div>
                    </div>
                `;
    },
   };

   // ===== Total Token Usage Management =====
   const totalTokenUsageManager = {
    async load() {
     try {
      const res = await fetch(`${CONFIG.TOTAL_TOKEN_USAGE_API_URL}?sessionId=${encodeURIComponent(state.sessionId)}`);
      const result = await res.json();
      if (result.success && result.responseObject) {
       const usage = result.responseObject;
       elements.tokenUsageHeaderValues.textContent = `Prompt: ${(usage.prompt_tokens || 0).toLocaleString()} · Completion: ${(
        usage.completion_tokens || 0
       ).toLocaleString()} · Total: ${(usage.total_tokens || 0).toLocaleString()}`;
      }
     } catch (error) {
      console.error('Error loading total token usage:', error);
     }
    },
   };

   // ===== Stream Processing =====
   const streamProcessor = {
     process(data) {
      if (data.type === 'stream_start') {
       state.isStreaming = true;
       state.combinedContent = '';
       state.currentRagSources = [];
       state.streamStartTime = Date.now();
       state.requestStartTime = data.requestStartTime || Date.now();
       state.requestEndTime = null;
       state.streamMessageCount = 0;
       state.lastTokensPerSecond = 0;
       utils.setStopButtonEnabled(true);
       return utils.getLoadingMessage();
      }

      if (data.type === 'stream_continue' && state.isStreaming) {
       if (data.aiResponse?.content) {
        state.combinedContent += data.aiResponse.content;
       }
       return state.combinedContent;
      }

      if (data.type === 'stream_end' && state.isStreaming) {
       state.isStreaming = false;
       utils.setStopButtonEnabled(false);
       this.recordTokensPerSecond(data.tokenUsage);
       return state.combinedContent;
      }

      if (data.type === 'stream_stopped') {
       state.isStreaming = false;
       utils.setStopButtonEnabled(false);
       this.recordTokensPerSecond(data.tokenUsage);
       return state.combinedContent || 'Stopped.';
      }

      if (data.type === 'stream_error' || data.type === 'error') {
       state.isStreaming = false;
       utils.setStopButtonEnabled(false);
       return `Error: ${data.error || 'Something went wrong while streaming.'}`;
      }

      return '';
     },

     recordTokensPerSecond(tokenUsage) {
      const completionTokens = tokenUsage?.completion_tokens || 0;
      const elapsedSeconds = (Date.now() - state.streamStartTime) / 1000;
      if (elapsedSeconds > 0 && completionTokens > 0) {
       state.lastTokensPerSecond = completionTokens / elapsedSeconds;
      }
     },
    };

   // ===== WebSocket Management =====
   const websocketManager = {
    connect() {
     state.socket = new WebSocket(CONFIG.WS_URL);

     state.socket.addEventListener('open', () => {
      messageManager.append('System', 'Connected to chat server.', 'system');
      state.isConnected = true;
     });

     state.socket.addEventListener('message', (event) => {
      this.handleMessage(event);
     });

     state.socket.addEventListener('close', () => {
      messageManager.append('System', 'Disconnected from chat server.', 'system');
      state.isConnected = false;
      state.isStreaming = false;
      utils.setStopButtonEnabled(false);
      this.scheduleReconnect();
     });
    },

    handleMessage(event) {
     const data = JSON.parse(event.data);
     console.log('Message from server:', event.data);

     if (data.isRelated !== undefined) {
      state.currentIsRelated = data.isRelated;
     }

     if (data.ragSources !== undefined && Array.isArray(data.ragSources) && data.ragSources.length > 0) {
      state.currentRagSources = data.ragSources;
     }

     const displayValue = streamProcessor.process(data);
     const messageType = data.sender === 'AI' ? 'ai' : 'user';
     const lastMsg = messageManager.updateLast(data.sender, displayValue, messageType);

     if (lastMsg) {
      if (data.sender === 'AI') {
       const indicator = lastMsg.querySelector('.related-indicator');
       if (indicator) {
        indicatorManager.update(lastMsg, state.currentIsRelated);
       } else {
        indicatorManager.add(lastMsg, state.currentIsRelated);
       }
       sourcesManager.add(lastMsg, state.currentRagSources);
      }
     } else {
      const msgElement = messageManager.append(data.sender, displayValue, messageType);
      if (data.sender === 'AI') {
       indicatorManager.add(msgElement, state.currentIsRelated);
       sourcesManager.add(msgElement, state.currentRagSources);
       // Initialize token usage section for AI messages
       tokenUsageManager.add(msgElement, {});
      }
     }

// Reload history and scroll to bottom on completion
     if (
      data.type === 'stream_end' ||
      data.type === 'stream_stopped' ||
      data.type === 'stream_error' ||
      data.type === 'error'
     ) {
       const lastMsg = elements.messages.lastElementChild;
       if (lastMsg) {
        // Show retrieved RAG sources (if this turn used RAG)
        sourcesManager.add(lastMsg, state.currentRagSources);
        // Show token usage returned by the WebSocket API
        tokenUsageManager.add(lastMsg, data.tokenUsage || {});
        // Show request start / end / duration
        timingManager.update(
         lastMsg,
         data.requestStartTime || state.requestStartTime,
         data.requestEndTime || state.requestEndTime
        );
       }
       totalTokenUsageManager.load();
       historyManager.loadHistory();
       utils.scrollToBottom(true);
     }

     // Scroll every 4th streaming chunk so the view tracks long responses
     if (data.type === 'stream_continue' && state.isStreaming) {
      state.streamMessageCount += 1;
      if (state.streamMessageCount % 4 === 0) {
       utils.scrollToBottom(true);
      }
     }
    },

    scheduleReconnect() {
     setTimeout(() => {
      messageManager.append('System', 'Reconnecting...', 'system');
      if (!state.isConnected) {
       this.connect();
      }
     }, CONFIG.RECONNECT_DELAY);
    },

    send(message) {
     if (state.socket && state.socket.readyState === WebSocket.OPEN) {
      state.socket.send(JSON.stringify(message));
     }
    },
   };

   // ===== Model Management =====
   const modelManager = {
    init() {
     this.bindSheet();
     this.bindSearch();
     this.loadLoadedModels();
    },

    bindSearch() {
     elements.modelSearchInput.addEventListener('input', () => {
      state.modelSearchQuery = elements.modelSearchInput.value;
      this.renderModels();
     });
    },

    bindSheet() {
     elements.modelViewAllBtn.addEventListener('click', () => {
      this.renderSheet();
      this.openSheet();
     });
     elements.modelSheetClose.addEventListener('click', () => this.closeSheet());
     elements.modelSheetOverlay.addEventListener('click', (e) => {
      if (e.target === elements.modelSheetOverlay) {
       this.closeSheet();
      }
     });
     document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !elements.modelSheetOverlay.hidden) {
       this.closeSheet();
      }
     });
    },

    openSheet() {
     elements.modelSheetOverlay.hidden = false;
     setTimeout(() => elements.modelSheetOverlay.classList.add('open'), 10);
    },

    closeSheet() {
     elements.modelSheetOverlay.classList.remove('open');
     setTimeout(() => {
      elements.modelSheetOverlay.hidden = true;
     }, 250);
    },

    async loadModels() {
     try {
      const url = new URL(CONFIG.MODELS_API_URL);
      if (state.selectedProvider) {
       url.searchParams.set('provider', state.selectedProvider);
      }
      const res = await fetch(url);
      const { models } = await res.json();

      if (Array.isArray(models) && models.length > 0) {
       console.log('Fetched models:', models);
       state.allModels = models;
       const persistedSelected = models.findIndex((m) => m.value === state.selectedModel);
       const selectedIndex = persistedSelected >= 0 ? persistedSelected : CONFIG.DEFAULT_MODEL_INDEX;
       state.selectedModel = models[selectedIndex]?.value || models[0].value;
       localStorage.setItem('chatSelectedModel', state.selectedModel);
       this.renderModels();
       this.renderSheet();
      }
     } catch (error) {
      console.error('Error fetching models:', error);
     }
    },

    renderModels() {
     const preview = this.filterModels(this.getPreviewModels());
     elements.modelSelector.innerHTML = preview.length
      ? preview.map((model) => this.rowTemplate(model, state.selectedModel)).join('')
      : '<div class="model-search-empty">No models match your search</div>';
     this.bindRowEvents(elements.modelSelector);
    },

    filterModels(models) {
     const query = state.modelSearchQuery.trim().toLowerCase();
     if (!query) return models;
     return models.filter((model) =>
      `${model.label} ${model.value}`.toLowerCase().includes(query)
     );
    },

    renderSheet() {
     elements.modelSheetBody.innerHTML = state.allModels
      .map((model) => this.rowTemplate(model, state.selectedModel))
      .join('');
     elements.modelSheetCount.textContent = `${state.allModels.length} model${state.allModels.length === 1 ? '' : 's'}`;
     this.bindRowEvents(elements.modelSheetBody);
    },

    getPreviewModels() {
     const models = state.allModels;
     const preview = [];
     const push = (model) => {
      if (!preview.some((m) => m.value === model.value)) {
       preview.push(model);
      }
     };

     models.forEach((model) => {
      if (state.loadedModelsByName[model.value]) {
       push(model);
      }
     });
     models.forEach((model) => {
      if (model.value === state.selectedModel) {
       push(model);
      }
     });
     models.forEach((model) => push(model));

     return preview;
    },

    rowTemplate(model, selectedModelValue) {
     const defaultModelValue = state.defaultModel || CONFIG.DEFAULT_MODEL;
     const isLoaded = Boolean(state.loadedModelsByName[model.value]);
     const isSelected = model.value === selectedModelValue;
     return `
                     <div class="model-row${isLoaded ? ' loaded' : ''}">
                         <div class="model-row-top">
                             <label class="model-default-toggle" title="Set as default model">
                                 <input type="checkbox" class="model-default-check" data-model="${model.value}" ${
                                   model.value === defaultModelValue ? 'checked' : ''
                                 } />
<span class="model-default-box"></span>
                             </label>
                             <button
                                 type="button"
                                 class="model-btn"
                                 data-model="${model.value}"
                                 aria-pressed="${isSelected ? 'true' : 'false'}"
                             >
                                 ${model.label}
                             </button>
                         </div>
                         <button
                             type="button"
                             class="model-unload-btn"
                             data-model="${model.value}"
                             title="Unload from RAM"
                             aria-label="Unload ${model.value}"
                             ${isLoaded ? '' : 'disabled'}
                         >Unload</button>
                     </div>
                 `;
    },

    bindRowEvents(container) {
     const modelBtns = container.querySelectorAll('.model-btn');
     modelBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
       this.selectModel(btn.getAttribute('data-model'));
      });
     });

     const defaultChecks = container.querySelectorAll('.model-default-check');
     defaultChecks.forEach((check) => {
      check.addEventListener('change', () => {
       const checkedValue = check.getAttribute('data-model');
       if (check.checked) {
        state.defaultModel = checkedValue;
        localStorage.setItem('chatDefaultModel', checkedValue);
        document.querySelectorAll('.model-default-check').forEach((c) => {
         c.checked = c.getAttribute('data-model') === checkedValue;
        });
        this.selectModel(checkedValue);
       } else {
        check.checked = true;
       }
      });
     });

     const unloadBtns = container.querySelectorAll('.model-unload-btn');
     unloadBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
       this.unloadSingleModel(btn.getAttribute('data-model'), btn);
      });
     });
    },

    selectModel(value) {
     state.selectedModel = value;
     localStorage.setItem('chatSelectedModel', value);
     document.querySelectorAll('.model-btn').forEach((b) => {
      b.setAttribute('aria-pressed', b.getAttribute('data-model') === value ? 'true' : 'false');
     });
    },

    async loadLoadedModels() {
     try {
      const res = await fetch(CONFIG.LOADED_MODELS_API_URL);
      const result = await res.json();
      const models = Array.isArray(result.responseObject) ? result.responseObject : [];
      this.updateLoadedModels(models);
     } catch (error) {
      console.error('Error fetching loaded models:', error);
     }
    },

    updateLoadedModels(models) {
     const loadedByName = {};
     models.forEach((model) => {
      if (model && model.model) {
       loadedByName[model.model] = true;
      }
     });
     state.loadedModelsByName = loadedByName;

     if (state.allModels.length) {
      this.renderModels();
      this.renderSheet();
     } else {
      this.syncLoadedState(elements.modelSelector);
      this.syncLoadedState(elements.modelSheetBody);
     }
    },

    syncLoadedState(container) {
     const rows = container.querySelectorAll('.model-row');
     rows.forEach((row) => {
      const btn = row.querySelector('.model-btn');
      const unloadBtn = row.querySelector('.model-unload-btn');
      if (!btn) return;
      const modelValue = btn.getAttribute('data-model');
      const isLoaded = Boolean(state.loadedModelsByName[modelValue]);

      row.classList.toggle('loaded', isLoaded);
      if (unloadBtn) {
       unloadBtn.disabled = !isLoaded;
      }
     });
    },

    async unloadSingleModel(model, btn) {
     if (!model || btn.disabled) {
      return;
     }

     btn.disabled = true;
     btn.textContent = 'Unloading…';
     messageManager.append('System', `Unloading model ${model}...`, 'system');

     try {
      const res = await fetch(CONFIG.UNLOAD_MODEL_API_URL, {
       method: 'POST',
       headers: { 'Content-Type': 'application/json' },
       body: JSON.stringify({ model }),
      });
      const result = await res.json();
      messageManager.append('System', result.message || 'Model unloaded.', 'system');
     } catch (error) {
      console.error(`Error unloading model ${model}:`, error);
      messageManager.append('System', `Error unloading model ${model}.`, 'system');
     } finally {
      btn.disabled = false;
      btn.textContent = 'Unload';
      this.loadLoadedModels();
     }
    },
   };

   // ===== Provider Management =====
   const providerManager = {
    init() {
     elements.providerSelector.addEventListener('change', () => {
      this.selectProvider(elements.providerSelector.value);
     });
    },

    selectProvider(value) {
     if (!value) return;
     state.selectedProvider = value;
     localStorage.setItem('chatSelectedProvider', value);
     modelManager.loadModels();
     modelManager.loadLoadedModels();
    },

    async loadProviders() {
     try {
      const res = await fetch(CONFIG.PROVIDERS_API_URL);
      const result = await res.json();
      const providers = Array.isArray(result.responseObject) ? result.responseObject : [];

      if (providers.length === 0) {
       elements.providerSelector.innerHTML = '<option value="">No providers</option>';
       return;
      }

      elements.providerSelector.innerHTML = providers
       .map((p) => `<option value="${p.name}">${p.name}</option>`)
       .join('');

      const persisted = providers.find((p) => p.name === state.selectedProvider);
      const selected = persisted ? persisted.name : providers[0].name;
      this.selectProvider(selected);
      elements.providerSelector.value = selected;
     } catch (error) {
      console.error('Error fetching providers:', error);
      elements.providerSelector.innerHTML = '<option value="">Providers unavailable</option>';
     }
    },
   };

