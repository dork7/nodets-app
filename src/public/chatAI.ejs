    setActionButtonsBusy(selector, busy, busyText) {
     document.querySelectorAll(selector).forEach((btn) => {
      if (busy) {
       if (btn.dataset.originalText === undefined) btn.dataset.originalText = btn.textContent;
       btn.textContent = busyText;
       btn.disabled = true;
      } else {
       if (btn.dataset.originalText !== undefined) {
        btn.textContent = btn.dataset.originalText;
        delete btn.dataset.originalText;
       }
       btn.disabled = false;
      }
     });
    },

    clearAllIngestions() {
     historyManager.openConfirmModal({
      title: 'Delete All Ingestions',
      body: 'Remove every ingested chunk from the vector DB? Uploaded files are kept, but you will need to re-ingest them. This cannot be undone.',
      confirmLabel: 'Yes, Delete All',
      onConfirm: () => this.performClearIngestions(),
     });
    },

    async performClearIngestions() {
     this.setActionButtonsBusy('.js-rag-clear-ingestions', true, 'Deleting...');
     try {
      const res = await fetch(CONFIG.RAG_API_URL, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) {
       messageManager.append('System', 'Deleted all ingestions from the vector DB.', 'system');
       await this.loadFiles();
      } else {
       this.openErrorPopup(`Failed to delete ingestions: ${result.message}`);
      }
     } catch (error) {
      this.openErrorPopup('Failed to delete ingestions.');
     } finally {
      this.setActionButtonsBusy('.js-rag-clear-ingestions', false);
     }
