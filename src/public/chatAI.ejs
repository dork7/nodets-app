         <svg class="icon-stop" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="6" y="6" width="12" height="12" rx="2"></rect>
         </svg>
        </button>
       </div>
       <div id="input-attachments"></div>
       <div class="input-controls">
       <div class="streaming-toggle-container">
        <label class="streaming-toggle-label">
         <span id="streaming-label">Streaming</span>
         <span class="streaming-toggle-wrapper">
