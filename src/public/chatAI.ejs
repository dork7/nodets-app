      try {
       const res = await fetch(CONFIG.RAG_INGEST_API_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
         source: 'minio',
         fileId: file.id,
         bucket: CONFIG.RAG_BUCKET,
         provider: state.selectedProvider || undefined,
         stream: state.ragStreaming,
        }),
       });
      const result = await res.json();
      if (result.success) {
       messageManager.append(
        'System',
        `Ingested "${this.displayName(file)}" (${result.responseObject?.count ?? 0} chunks).`,
        'system'
       );
       await this.loadFiles();
      } else {
       this.openErrorPopup(`Failed to ingest "${this.displayName(file)}": ${result.message}`);
      }
     } catch (error) {
      this.openErrorPopup(`Failed to ingest "${this.displayName(file)}".`);
     }
    },

    async purgeVectors(file, btn) {
     const originalText = btn ? btn.textContent : '';
     if (btn) {
      btn.disabled = true;
      btn.textContent = 'Removing...';
