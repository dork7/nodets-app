<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>ChatAI Window</title>
    <style>
        /* ===== Color Palette ===== */
        :root {
            --bg-primary: #0a0a0a;
            --bg-secondary: #141414;
            --bg-tertiary: #1a1a1a;
            --bg-card: #1f1f1f;
            --bg-input: #2a2a2a;
            --bg-hover: #333333;
            --text-primary: #e5e5e5;
            --text-secondary: #a0a0a0;
            --text-accent: #d4d4d4;
            --accent-primary: #888888;
            --accent-secondary: #666666;
            --accent-tertiary: #999999;
            --user-msg: #2a2a2a;
            --ai-msg: #1f1f1f;
            --system-msg: #3a3a3a;
            --success: #22c55e;
            --error: #ef4444;
            --border: #333333;
            --shadow: rgba(0, 0, 0, 0.4);
        }

        /* ===== Base Styles ===== */
        body {
            background: var(--bg-primary);
            color: var(--text-primary);
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Arial, sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        a {
            color: var(--text-primary);
            text-decoration: underline;
            transition: opacity 0.2s;
        }

        a:hover {
            opacity: 0.7;
        }

        /* ===== Main Container ===== */
        #main-container {
            display: flex;
            gap: 16px;
            max-width: 95vw;
            margin: 40px auto;
            height: 70vh;
        }

        /* ===== Chat Container ===== */
        #chat-container {
            background: var(--bg-card);
            flex: 1;
            border-radius: 8px;
            border: 1px solid var(--border);
            padding: 24px 16px 16px 16px;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(10px);
        }

        /* ===== Side Panel ===== */
        #history-panel {
            width: 300px;
            background: var(--bg-card);
            border-radius: 8px;
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease;
        }


        #history-panel-header {
            padding: 24px 16px 16px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #history-panel-title {
            font-size: 1em;
            font-weight: 500;
            color: var(--text-primary);
        }

        #close-history-btn {
            display: none;
        }

        #history-content {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
        }

        .history-item {
            padding: 12px;
            margin-bottom: 8px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 4px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .history-item:hover {
            background: var(--bg-hover);
        }

        .history-item-content {
            color: var(--text-primary);
            font-size: 0.9em;
            line-height: 1.4;
            word-break: break-word;
        }

        .history-item-time {
            color: var(--text-secondary);
            font-size: 0.75em;
            margin-top: 4px;
        }

        #history-content::-webkit-scrollbar {
            width: 6px;
        }

        #history-content::-webkit-scrollbar-track {
            background: transparent;
        }

        #history-content::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 3px;
        }

        #history-content::-webkit-scrollbar-thumb:hover {
            background: var(--text-secondary);
        }

        #messages {
            flex: 1;
            overflow-y: auto;
            margin-bottom: 18px;
            padding-right: 6px;
            display: flex;
            flex-direction: column;
        }

        /* Custom Scrollbar */
        #messages::-webkit-scrollbar {
            width: 6px;
        }

        #messages::-webkit-scrollbar-track {
            background: transparent;
        }

        #messages::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 3px;
        }

        #messages::-webkit-scrollbar-thumb:hover {
            background: var(--text-secondary);
        }

        /* ===== Message Styles ===== */
        .message {
            display: block;
            margin-bottom: 12px;
            padding: 10px 42px 10px 16px;
            border-radius: 4px;
            max-width: 80%;
            word-break: break-word;
            position: relative;
            font-size: 1rem;
            line-height: 1.6;
        }

        .message.user {
            background: var(--user-msg);
            color: var(--text-primary);
            align-self: flex-end;
            border-bottom-right-radius: 4px;
            text-align: right;
            border: 1px solid var(--border);
        }

        .message.ai {
            position: relative;
            background: var(--ai-msg);
            color: var(--text-primary);
            border: 1px solid var(--border);
            display: flex;
            flex-direction: column;
        }

        .message-content {
            flex: 1;
        }

        .copy-message-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 26px;
            height: 26px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid transparent;
            border-radius: 4px;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.2s, color 0.2s, background 0.2s, border-color 0.2s;
        }

        .message:hover .copy-message-btn,
        .copy-message-btn:focus {
            opacity: 1;
        }

        .copy-message-btn:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
            border-color: var(--border);
        }

        .copy-message-btn.copied {
            color: var(--success);
            opacity: 1;
        }

        .copy-message-btn svg {
            width: 15px;
            height: 15px;
            pointer-events: none;
        }

        .message.system {
            background: var(--system-msg);
            color: var(--text-secondary);
            text-align: left;
            font-size: 0.95em;
            border-radius: 8px;
            margin: 8px 0;
            max-width: 60%;
            align-self: flex-start;
            border: 1px solid var(--border);
        }

        /* ===== AI Message Content Styles ===== */
        .message.ai pre,
        .message.ai pre code {
            background: rgba(0, 0, 0, 0.3);
            color: var(--text-primary);
            font-family: 'Fira Code', 'Fira Mono', 'Consolas', monospace;
            font-size: 0.98em;
            border-radius: 4px;
            padding: 12px 16px;
            overflow-x: auto;
            margin: 8px 0;
            display: block;
            border: 1px solid var(--border);
        }

        .message.ai code {
            background: rgba(0, 0, 0, 0.3);
            color: var(--text-primary);
            font-family: 'Fira Code', 'Fira Mono', 'Consolas', monospace;
            font-size: 0.98em;
            border-radius: 4px;
            padding: 4px 8px;
            overflow-x: auto;
            margin: 4px 0;
            border: 1px solid var(--border);
        }

        .message.ai strong {
            color: var(--text-primary);
            font-weight: 600;
        }

        .message.ai em {
            color: var(--text-secondary);
            font-style: italic;
        }

        .message.ai a {
            color: var(--text-primary);
            text-decoration: underline;
            transition: opacity 0.2s;
        }

        .message.ai a:hover {
            opacity: 0.7;
        }

        /* ===== Related Indicator Styles ===== */
        .related-indicator-section {
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
        }

        .related-indicator {
            font-size: 0.75em;
            font-weight: 500;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .related-indicator::after {
            content: '';
            width: 10px;
            height: 10px;
            border-radius: 50%;
            transition: all 0.3s ease;
        }

        .related-indicator.related {
            color: var(--success);
        }

        .related-indicator.related::after {
            background-color: var(--success);
        }

        .related-indicator.unrelated {
            color: var(--error);
        }

        .related-indicator.unrelated::after {
            background-color: var(--error);
        }

        /* ===== Token Usage Styles ===== */
        .token-usage-section {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            font-size: 0.75em;
            color: var(--text-secondary);
        }

        .token-usage {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .token-usage-item {
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .token-usage-label {
            color: var(--text-secondary);
        }

        .token-usage-value {
            color: var(--text-primary);
            font-weight: 500;
        }

        /* ===== Input Form Styles ===== */
        #drop-overlay {
            position: absolute;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.5);
            color: #fff;
            font-size: 1.4em;
            font-weight: 500;
            border-radius: 4px;
            z-index: 10;
            pointer-events: none;
        }

        #chat-container {
            position: relative;
        }

        #drop-overlay.active {
            display: flex;
        }

        #input-form {
            display: flex;
            gap: 8px;
            margin-top: 8px;
        }

        #input {
            flex: 1;
            padding: 10px 14px;
            border-radius: 4px;
            border: 1px solid var(--border);
            background: var(--bg-input);
            color: var(--text-primary);
            font-size: 1em;
            outline: none;
            transition: border-color 0.2s;
        }

        #input:focus {
            border-color: var(--text-secondary);
        }

        #input::placeholder {
            color: var(--text-secondary);
        }

        #send,
        #stop-stream,
        #upload-btn {
            background: var(--bg-input);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 10px 20px;
            font-size: 1em;
            font-weight: 400;
            cursor: pointer;
            transition: background 0.2s;
        }

        #send:hover,
        #stop-stream:not(:disabled):hover,
        #upload-btn:hover:not(:disabled) {
            background: var(--bg-hover);
        }

        #stop-stream:disabled,
        #upload-btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        /* ===== Streaming Toggle Styles ===== */
        .streaming-toggle-container {
            display: flex;
            align-items: center;
        }

        .streaming-toggle-label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 1em;
            color: var(--text-secondary);
            cursor: pointer;
            font-weight: 400;
        }

        .streaming-toggle-wrapper {
            position: relative;
            display: inline-block;
            width: 44px;
            height: 24px;
        }

        .streaming-toggle-input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .streaming-toggle-track {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: var(--bg-input);
            border-radius: 24px;
            transition: all 0.3s ease;
            border: 2px solid var(--border);
        }

        .streaming-toggle-thumb {
            position: absolute;
            left: 2px;
            top: 2px;
            width: 18px;
            height: 18px;
            background: var(--text-primary);
            border-radius: 50%;
            transition: transform 0.2s ease;
        }

        .streaming-toggle-input:checked + .streaming-toggle-track {
            background: var(--bg-hover);
            border-color: var(--text-secondary);
        }

        .streaming-toggle-input:checked + .streaming-toggle-track + .streaming-toggle-thumb {
            transform: translateX(20px);
        }

        /* ===== Model Selector Styles ===== */
        #model-selector-container {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            margin-top: 16px;
            margin-bottom: 16px;
            padding: 16px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 4px;
        }

        .model-selector-label {
            color: var(--text-secondary);
            font-size: 1em;
            font-weight: 400;
        }

        #model-selector {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .model-btn {
            background: var(--bg-input);
            color: var(--text-secondary);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 6px 12px;
            font-size: 0.9em;
            cursor: pointer;
            transition: all 0.2s;
            outline: none;
            font-weight: 400;
        }

        .model-btn:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }

        .model-btn[aria-pressed="true"] {
            background: var(--bg-hover);
            color: var(--text-primary);
            border-color: var(--text-secondary);
        }

        .model-btn:focus {
            outline: 1px solid var(--text-secondary);
            outline-offset: 2px;
        }

        /* ===== Loaded Models Styles ===== */
        #loaded-models-container {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 12px;
            padding: 16px;
            background: var(--bg-tertiary);
            border: 1px solid var(--border);
            border-radius: 4px;
        }

        #loaded-models {
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
        }

        .loaded-models-empty {
            color: var(--text-secondary);
            font-size: 0.9em;
            margin: 0;
        }

        .loaded-model-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 8px 12px;
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 4px;
        }

        .loaded-model-name {
            color: var(--text-primary);
            font-weight: 500;
            font-size: 0.9em;
            word-break: break-all;
        }

        .loaded-model-meta {
            color: var(--text-secondary);
            font-size: 0.8em;
            margin-left: auto;
        }

        .unload-model-btn {
            background: var(--bg-input);
            color: var(--text-primary);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 4px 10px;
            font-size: 0.85em;
            cursor: pointer;
            transition: all 0.2s;
        }

        .unload-model-btn:hover:not(:disabled) {
            background: var(--bg-hover);
            border-color: var(--text-secondary);
        }

        .unload-model-btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

        /* ===== History Button Styles ===== */
        #history-btn {
            display: none;
        }
    </style>
</head>
<body>
    <div id="main-container">
        <div id="history-panel">
            <div id="history-panel-header">
                <h3 id="history-panel-title">Chat History</h3>
                <button id="close-history-btn" type="button">×</button>
            </div>
            <div id="history-content"></div>
        </div>
    <div id="chat-container">
        <div id="drop-overlay">Drop files to upload</div>
        <div id="messages"></div>
        <form id="input-form">
            <input id="input" autocomplete="off" placeholder="Type your message..." />
            
            <div class="streaming-toggle-container">
                <label class="streaming-toggle-label">
                    <span id="streaming-label">Streaming</span>
                    <span class="streaming-toggle-wrapper">
                        <input type="checkbox" id="stream-toggle" class="streaming-toggle-input" checked>
                        <span class="streaming-toggle-track"></span>
                        <span class="streaming-toggle-thumb"></span>
                    </span>
                </label>
            </div>
            
            <button id="send" type="submit">Send</button>
            <button id="stop-stream" type="button" disabled>Stop</button>
            
            <button type="button" id="upload-btn" title="Upload file">Upload</button>
            <input id="file-input" type="file" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.gif,.webp,.svg,.bmp,.ico,.tiff,.tif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/*" hidden />
            
            <button type="button" id="history-btn">Show History</button>
        </form>
        <div id="model-selector-container">
            <div class="model-selector-label">AI Model</div>
            <div id="model-selector"></div>
        </div>
        <div id="loaded-models-container">
            <div class="model-selector-label">Loaded Models (RAM)</div>
            <div id="loaded-models">
                <p class="loaded-models-empty">No models loaded in memory.</p>
            </div>
        </div>
    </div>
    </div>

    <script nonce="abc123">
        // ===== Configuration =====
        const CONFIG = {
            WS_URL: 'ws://localhost:2020/ws/chatAI',
            MODELS_API_URL: 'http://localhost:2020/chatModels',
            HISTORY_API_URL: 'http://localhost:2020/v1/aiUtils/chat-history',
            LOADED_MODELS_API_URL: 'http://localhost:2020/v1/aiUtils/loaded-models',
            UNLOAD_MODEL_API_URL: 'http://localhost:2020/v1/aiUtils/unload-model',
            UPLOAD_API_URL: 'http://localhost:2020/v1/minio/upload',
            MAX_FILE_SIZE: 10 * 1024 * 1024,
            RECONNECT_DELAY: 5000,
            DEFAULT_MODEL_INDEX: 1,
            LOADING_MESSAGES: [
                'Cooking...',
                'Chirming...',
                'Loading...',
                'Fking...',
                'Thinking...',
                'Brewing...',

                'Almost there...',
                'Stirring the soup...',
                'Connecting neurons...',
                'Reading vibes...',
                'Generating chaos...',
                'One sec...',
 
                'Feeding the model...',
 
                'Loading brain juice...',
    
                'Tuning antennas...',

                'Doing model stuff...',
              
                'Typing imaginary notes...',
                'Negotiating with electrons...'
            ]
        };

        // ===== State Management =====
        const state = {
            selectedModel: '',
            streamingEnabled: true,
            isStreaming: false,
            isConnected: false,
            currentIsRelated: false,
            combinedContent: '',
            socket: null,
            sessionId: `sess-${Math.random().toString(36).substr(2, 9)}`
        };

        // ===== DOM Elements =====
        const elements = {
            messages: document.getElementById('messages'),
            form: document.getElementById('input-form'),
            input: document.getElementById('input'),
            stopBtn: document.getElementById('stop-stream'),
            streamToggle: document.getElementById('stream-toggle'),
            streamingLabel: document.getElementById('streaming-label'),
            modelSelector: document.getElementById('model-selector'),
            loadedModels: document.getElementById('loaded-models'),
            uploadBtn: document.getElementById('upload-btn'),
            fileInput: document.getElementById('file-input'),
            dropOverlay: document.getElementById('drop-overlay'),
            chatContainer: document.getElementById('chat-container'),
            historyBtn: document.getElementById('history-btn'),
            historyPanel: document.getElementById('history-panel'),
            historyContent: document.getElementById('history-content'),
            closeHistoryBtn: document.getElementById('close-history-btn')
        };

        // ===== Utility Functions =====
        const utils = {
            parseMarkdown(text) {
                return text
                    .replace(/(?:__|\*\*)(.*?)\1/g, '<strong>$1</strong>')
                    .replace(/(?:_|\*)(.*?)\1/g, '<em>$1</em>')
                    .replace(/```([\s\S]*?)```/g, '<pre><code>$1</code></pre>')
                    .replace(/`([^`]+)`/g, '<code>$1</code>')
                    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank">$1</a>')
                    .replace(/\n/g, '<br>');
            },

            scrollToBottom() {
                elements.messages.scrollTop = elements.messages.scrollHeight;
            },

            getLoadingMessage() {
                const index = Math.floor(Math.random() * CONFIG.LOADING_MESSAGES.length);
                return CONFIG.LOADING_MESSAGES[index];
            },

            setStopButtonEnabled(isEnabled) {
                elements.stopBtn.disabled = !isEnabled;
            },

            async copyToClipboard(text) {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                    return;
                }

                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.setAttribute('readonly', '');
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                textarea.remove();
            }
        };

        // ===== Message Management =====
        const messageManager = {
            createCopyButton() {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'copy-message-btn';
                button.title = 'Copy message';
                button.setAttribute('aria-label', 'Copy message text');
                button.innerHTML = `
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="9" y="9" width="10" height="10" rx="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"></path>
                    </svg>
                `;
                button.addEventListener('click', async (event) => {
                    event.stopPropagation();
                    const messageElement = button.closest('.message');
                    const textToCopy = messageElement?.dataset.copyText || '';

                    try {
                        await utils.copyToClipboard(textToCopy);
                        button.classList.add('copied');
                        button.title = 'Copied';
                        button.setAttribute('aria-label', 'Copied message text');
                        setTimeout(() => {
                            button.classList.remove('copied');
                            button.title = 'Copy message';
                            button.setAttribute('aria-label', 'Copy message text');
                        }, 1200);
                    } catch (error) {
                        console.error('Unable to copy message:', error);
                    }
                });

                return button;
            },

            setCopyText(messageElement, message) {
                messageElement.dataset.copyText = message;
            },

            append(sender, message, type) {
                const div = document.createElement('div');
                div.className = `message ${type}`;
                this.setCopyText(div, message);
                
                if (type === 'ai') {
                    // Create content div first (will be inserted after indicator if it exists)
                    const contentDiv = document.createElement('div');
                    contentDiv.className = 'message-content';
                    contentDiv.innerHTML = `<strong>${sender}:</strong> ${utils.parseMarkdown(message)}`;
                    div.appendChild(contentDiv);
                } else {
                    div.innerHTML = `<strong>${sender}:</strong> ${utils.parseMarkdown(message)}`;
                }

                div.appendChild(this.createCopyButton());
                
                elements.messages.appendChild(div);
                utils.scrollToBottom();
                return div;
            },

            updateLast(sender, message, type) {
                const lastMsg = elements.messages.lastElementChild;
                if (lastMsg && lastMsg.classList.contains(type)) {
                    this.setCopyText(lastMsg, message);
                    if (type === 'ai') {
                        const contentDiv = lastMsg.querySelector('.message-content');
                        if (contentDiv) {
                            contentDiv.innerHTML = `<strong>${sender}:</strong> ${utils.parseMarkdown(message)}`;
                        } else {
                            const newContentDiv = document.createElement('div');
                            newContentDiv.className = 'message-content';
                            newContentDiv.innerHTML = `<strong>${sender}:</strong> ${utils.parseMarkdown(message)}`;
                            // Remove old content and add new structure
                            const oldContent = lastMsg.childNodes;
                            const indicatorSection = lastMsg.querySelector('.related-indicator-section');
                            Array.from(oldContent).forEach(node => {
                                if (!node.classList || (!node.classList.contains('related-indicator-section') && !node.classList.contains('copy-message-btn'))) {
                                    node.remove();
                                }
                            });
                            // Insert content after indicator section (if it exists) or at the beginning
                            if (indicatorSection) {
                                lastMsg.insertBefore(newContentDiv, indicatorSection.nextSibling);
                            } else {
                                lastMsg.appendChild(newContentDiv);
                            }
                        }
                    } else {
                        lastMsg.innerHTML = `<strong>${sender}:</strong> ${utils.parseMarkdown(message)}`;
                        lastMsg.appendChild(this.createCopyButton());
                    }
                    utils.scrollToBottom();
                    return lastMsg;
                }
                return null;
            }
        };

        // ===== Related Indicator Management =====
        const indicatorManager = {
            add(messageElement, isRelated) {
                if (!messageElement) return;
                
                let indicatorSection = messageElement.querySelector('.related-indicator-section');
                if (!indicatorSection) {
                    indicatorSection = document.createElement('div');
                    indicatorSection.className = 'related-indicator-section';
                    
                    const indicator = document.createElement('span');
                    indicator.className = 'related-indicator';
                    indicatorSection.appendChild(indicator);
                    
                    // Insert at the beginning (top) of the message element
                    const firstChild = messageElement.firstChild;
                    if (firstChild) {
                        messageElement.insertBefore(indicatorSection, firstChild);
                    } else {
                        messageElement.appendChild(indicatorSection);
                    }
                }
                this.update(messageElement, isRelated);
            },

            update(messageElement, isRelated) {
                const indicator = messageElement?.querySelector('.related-indicator');
                if (!indicator) return;

                indicator.classList.remove('related', 'unrelated');

                if (isRelated === true) {
                    indicator.classList.add('related');
                    indicator.textContent = 'Related';
                } else {
                    indicator.classList.add('unrelated');
                    indicator.textContent = 'Unrelated';
                }
            }
        };

        // ===== Token Usage Management =====
        const tokenUsageManager = {
            add(messageElement, tokenUsage) {
                if (!messageElement) return;

                let usageSection = messageElement.querySelector('.token-usage-section');
                if (!usageSection) {
                    usageSection = document.createElement('div');
                    usageSection.className = 'token-usage-section';
                    messageElement.appendChild(usageSection);
                }
                this.update(messageElement, tokenUsage);
            },

            update(messageElement, tokenUsage) {
                const usageSection = messageElement?.querySelector('.token-usage-section');
                if (!usageSection) return;

                const promptTokens = tokenUsage?.prompt_tokens || 0;
                const completionTokens = tokenUsage?.completion_tokens || 0;
                const totalTokens = tokenUsage?.total_tokens || 0;

                // Always show token usage section for AI messages
                usageSection.innerHTML = `
                    <div class="token-usage">
                        <div class="token-usage-item">
                            <span class="token-usage-label">Prompt:</span>
                            <span class="token-usage-value">${promptTokens.toLocaleString()}</span>
                        </div>
                        <div class="token-usage-item">
                            <span class="token-usage-label">Completion:</span>
                            <span class="token-usage-value">${completionTokens.toLocaleString()}</span>
                        </div>
                        <div class="token-usage-item">
                            <span class="token-usage-label">Total:</span>
                            <span class="token-usage-value">${totalTokens.toLocaleString()}</span>
                        </div>
                    </div>
                `;
                usageSection.style.display = 'flex';
            },

            async loadCumulativeUsage(userId) {
                try {
                    const response = await fetch(`${CONFIG.HISTORY_API_URL.replace('/chat-history', '/token-usage')}/${userId}`);
                    if (response.ok) {
                        const result = await response.json();
                        if (result.success && result.data) {
                            return result.data;
                        }
                    }
                } catch (error) {
                    console.error('Error loading cumulative token usage:', error);
                }
                return null;
            }
        };

        // ===== Stream Processing =====
        const streamProcessor = {
            process(data) {
                if (data.type === 'stream_start') {
                    state.isStreaming = true;
                    state.combinedContent = '';
                    utils.setStopButtonEnabled(true);
                    return utils.getLoadingMessage();
                }
                
                if (data.type === 'stream_continue' && state.isStreaming) {
                    if (data.aiResponse?.content) {
                        state.combinedContent += data.aiResponse.content;
                    }
                    return state.combinedContent;
                }
                
                if (data.type === 'stream_end' && state.isStreaming) {
                    state.isStreaming = false;
                    utils.setStopButtonEnabled(false);
                    return state.combinedContent;
                }

                if (data.type === 'stream_stopped') {
                    state.isStreaming = false;
                    utils.setStopButtonEnabled(false);
                    return state.combinedContent || 'Stopped.';
                }

                if (data.type === 'stream_error' || data.type === 'error') {
                    state.isStreaming = false;
                    utils.setStopButtonEnabled(false);
                    return `Error: ${data.error || 'Something went wrong while streaming.'}`;
                }
                
                return '';
            }
        };

        // ===== WebSocket Management =====
        const websocketManager = {
            connect() {
                state.socket = new WebSocket(CONFIG.WS_URL);
                
                state.socket.addEventListener('open', () => {
                    messageManager.append('System', 'Connected to chat server.', 'system');
                    state.isConnected = true;
                });

                state.socket.addEventListener('message', (event) => {
                    this.handleMessage(event);
                });

                state.socket.addEventListener('close', () => {
                    messageManager.append('System', 'Disconnected from chat server.', 'system');
                    state.isConnected = false;
                    this.scheduleReconnect();
                });
            },

            handleMessage(event) {
                const data = JSON.parse(event.data);
                console.log('Message from server:', event.data);

                if (data.isRelated !== undefined) {
                    state.currentIsRelated = data.isRelated;
                }

                const displayValue = streamProcessor.process(data);
                const messageType = data.sender === 'AI' ? 'ai' : 'user';
                const lastMsg = messageManager.updateLast(data.sender, displayValue, messageType);

                if (lastMsg) {
                    if (data.sender === 'AI') {
                        const indicator = lastMsg.querySelector('.related-indicator');
                        if (indicator) {
                            indicatorManager.update(lastMsg, state.currentIsRelated);
                        } else {
                            indicatorManager.add(lastMsg, state.currentIsRelated);
                        }
                    }
                } else {
                    const msgElement = messageManager.append(data.sender, displayValue, messageType);
                    if (data.sender === 'AI') {
                        indicatorManager.add(msgElement, state.currentIsRelated);
                        // Initialize token usage section for AI messages
                        tokenUsageManager.add(msgElement, {});
                    }
                }

                // Reload history after response completion
                if (data.type === 'stream_end' || data.type === 'stream_stopped' || data.type === 'stream_error' || data.type === 'error') {
                    const lastMsg = elements.messages.lastElementChild;
                    if (lastMsg) {
                        // Always show token usage section, even if data is missing
                        tokenUsageManager.add(lastMsg, data.tokenUsage || {});
                    }
                    historyManager.loadHistory();
                }
            },

            scheduleReconnect() {
                setTimeout(() => {
                    messageManager.append('System', 'Reconnecting...', 'system');
                    if (!state.isConnected) {
                        this.connect();
                    }
                }, CONFIG.RECONNECT_DELAY);
            },

            send(message) {
                if (state.socket && state.socket.readyState === WebSocket.OPEN) {
                    state.socket.send(JSON.stringify(message));
                }
            }
        };

        // ===== Model Management =====
        const modelManager = {
            init() {
                this.loadLoadedModels();
            },

            async loadModels() {
                try {
                    const res = await fetch(CONFIG.MODELS_API_URL);
                    const { models } = await res.json();
                    
                if (Array.isArray(models) && models.length > 0) {
                        console.log('Fetched models:', models);
                        this.renderModels(models);
                        state.selectedModel = models[CONFIG.DEFAULT_MODEL_INDEX]?.value || models[0].value;
                    }
                } catch (error) {
                    console.error('Error fetching models:', error);
                }
            },

            renderModels(models) {
                elements.modelSelector.innerHTML = models
                    .map((model, index) => `
                        <button
                            type="button"
                            class="model-btn"
                            data-model="${model.value}"
                            aria-pressed="${index === CONFIG.DEFAULT_MODEL_INDEX ? 'true' : 'false'}"
                        >
                            ${model.label}
                        </button>
                    `)
                    .join('');

                const modelBtns = elements.modelSelector.querySelectorAll('.model-btn');
                modelBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        modelBtns.forEach(b => b.setAttribute('aria-pressed', 'false'));
                        btn.setAttribute('aria-pressed', 'true');
                        state.selectedModel = btn.getAttribute('data-model');
                    });
                });
            },

            async loadLoadedModels() {
                try {
                    const res = await fetch(CONFIG.LOADED_MODELS_API_URL);
                    const result = await res.json();
                    const models = result.responseObject;
                    this.renderLoadedModels(models);
                } catch (error) {
                    console.error('Error fetching loaded models:', error);
                    elements.loadedModels.innerHTML =
                        '<p class="loaded-models-empty">Failed to load models.</p>';
                }
            },

            renderLoadedModels(models) {
                if (!Array.isArray(models) || models.length === 0) {
                    elements.loadedModels.innerHTML =
                        '<p class="loaded-models-empty">No models loaded in memory.</p>';
                    return;
                }

                elements.loadedModels.innerHTML = models
                    .map((model) => `
                        <div class="loaded-model-item">
                            <span class="loaded-model-name">${model.model}</span>
                            <span class="loaded-model-meta">${model.backend || ''}${model.in_memory ? ' · in memory' : ''}</span>
                            <button type="button" class="unload-model-btn" data-model="${model.model}">Unload</button>
                        </div>
                    `)
                    .join('');

                elements.loadedModels.querySelectorAll('.unload-model-btn').forEach((btn) => {
                    btn.addEventListener('click', () => {
                        this.unloadSingleModel(btn.getAttribute('data-model'), btn);
                    });
                });
            },

            async unloadSingleModel(model, btn) {
                if (!model || btn.disabled) {
                    return;
                }

                btn.disabled = true;
                const originalText = btn.textContent;
                btn.textContent = 'Unloading...';
                messageManager.append('System', `Unloading model ${model}...`, 'system');

                try {
                    const res = await fetch(CONFIG.UNLOAD_MODEL_API_URL, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ model }),
                    });
                    const result = await res.json();
                    messageManager.append('System', result.message || 'Model unloaded.', 'system');
                } catch (error) {
                    console.error(`Error unloading model ${model}:`, error);
                    messageManager.append('System', `Error unloading model ${model}.`, 'system');
                } finally {
                    btn.disabled = false;
                    btn.textContent = originalText;
                    this.loadLoadedModels();
                }
            }
        };

        // ===== Streaming Toggle Management =====
        const streamingToggle = {
            init() {
                elements.streamToggle.addEventListener('change', () => {
                    state.streamingEnabled = elements.streamToggle.checked;
                    this.updateLabel();
                });
                this.updateLabel();
            },

            updateLabel() {
                elements.streamingLabel.textContent = 
                    elements.streamToggle.checked ? 'Streaming' : 'No Streaming';
            }
        };

        // ===== Form Handling =====
        const formHandler = {
            init() {
                elements.form.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const message = elements.input.value.trim();
                    
                    if (message && state.socket) {
                        websocketManager.send({
                            sender: 'User',
                            type: 'request',
                            id: state.sessionId,
                            method: 'chatAI',
                            stream: state.streamingEnabled,
                            model: state.selectedModel,
                            params: { prompt: message }
                        });
                        
                        messageManager.append('You', message, 'user');
                        elements.input.value = '';
                    }
                });

                elements.stopBtn.addEventListener('click', () => {
                    if (!state.isStreaming || !state.socket) {
                        return;
                    }

                    websocketManager.send({
                        sender: 'User',
                        type: 'stop_stream',
                        id: state.sessionId,
                        method: 'chatAI'
                    });
                    utils.setStopButtonEnabled(false);
                });
            }
        };

        // ===== Upload Management =====
        const ACCEPTED_UPLOAD_TYPES = [
            'application/pdf',
            'application/msword',
            'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
            'image/png',
            'image/jpeg',
            'image/gif',
            'image/webp',
            'image/svg+xml',
            'image/bmp',
            'image/x-icon',
            'image/tiff'
        ];

        const ACCEPTED_UPLOAD_EXTENSIONS = [
            '.pdf',
            '.doc',
            '.docx',
            '.png',
            '.jpg',
            '.jpeg',
            '.gif',
            '.webp',
            '.svg',
            '.bmp',
            '.ico',
            '.tiff',
            '.tif'
        ];

        const uploadManager = {
            init() {
                elements.uploadBtn.addEventListener('click', () => {
                    elements.fileInput.value = '';
                    elements.fileInput.click();
                });

                elements.fileInput.addEventListener('change', () => {
                    if (elements.fileInput.files && elements.fileInput.files.length > 0) {
                        this.uploadFiles(Array.from(elements.fileInput.files));
                    }
                    elements.fileInput.value = '';
                });

                ['dragenter', 'dragover'].forEach((eventName) => {
                    elements.chatContainer.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        elements.dropOverlay.classList.add('active');
                    });
                });

                ['dragleave', 'drop'].forEach((eventName) => {
                    elements.chatContainer.addEventListener(eventName, (e) => {
                        e.preventDefault();
                        elements.dropOverlay.classList.remove('active');
                    });
                });

                elements.chatContainer.addEventListener('drop', (e) => {
                    e.preventDefault();
                    const files = e.dataTransfer && e.dataTransfer.files
                        ? Array.from(e.dataTransfer.files)
                        : [];
                    if (files.length > 0) {
                        this.uploadFiles(files);
                    }
                });
            },

            uploadFiles(files) {
                files.forEach((file) => this.uploadFile(file));
            },

            uploadFile(file) {
                if (file.size > CONFIG.MAX_FILE_SIZE) {
                    messageManager.append('System', `File "${file.name}" exceeds the ${Math.round(CONFIG.MAX_FILE_SIZE / 1024 / 1024)} MB size limit.`, 'system');
                    return;
                }

                const lowerName = file.name.toLowerCase();
                const hasAcceptedType = ACCEPTED_UPLOAD_TYPES.includes(file.type);
                const hasAcceptedExtension = ACCEPTED_UPLOAD_EXTENSIONS.some((ext) => lowerName.endsWith(ext));

                if (!hasAcceptedType && !hasAcceptedExtension) {
                    messageManager.append('System', `"${file.name}" is not a supported file. Only PDF, Word, and image files are allowed.`, 'system');
                    return;
                }

                messageManager.append('System', `Uploading "${file.name}"...`, 'system');

                const formData = new FormData();
                formData.append('file', file);

                const xhr = new XMLHttpRequest();
                xhr.open('POST', CONFIG.UPLOAD_API_URL);

                xhr.onload = () => {
                    try {
                        const result = JSON.parse(xhr.responseText);
                        if (xhr.status >= 200 && xhr.status < 300 && result.success && result.responseObject) {
                            const uploaded = result.responseObject;
                            messageManager.append('System', `Uploaded "${file.name}"`, 'system');
                            messageManager.append('System', `File URL: ${uploaded.url}`, 'system');
                        } else {
                            messageManager.append('System', `Upload failed: ${result.message || `HTTP ${xhr.status}`}`, 'system');
                        }
                    } catch (error) {
                        console.error('Error parsing upload response:', error);
                        messageManager.append('System', `Upload failed: unexpected server response.`, 'system');
                    }
                };

                xhr.onerror = () => {
                    messageManager.append('System', `Upload failed: network error for "${file.name}".`, 'system');
                };

                xhr.send(formData);
            }
        };

        // ===== History Management =====
        const historyManager = {
            async loadHistory() {
                if (!elements.historyContent) return;
                
                try {
                    const response = await fetch(`${CONFIG.HISTORY_API_URL}/${state.sessionId}`);
                    const data = await response.json();
                    
                    if (data.success && data.responseObject && Array.isArray(data.responseObject)) {
                        // Clear existing history content
                        elements.historyContent.innerHTML = '';
                        
                        if (data.responseObject.length === 0) {
                            elements.historyContent.innerHTML = '<div class="history-item"><div class="history-item-content">No chat history found.</div></div>';
                        } else {
                            // Display each user message from history in the side panel
                            data.responseObject.forEach((msg) => {
                                if (msg.role === 'user' && msg.content) {
                                    const historyItem = document.createElement('div');
                                    historyItem.className = 'history-item';
                                    
                                    const content = document.createElement('div');
                                    content.className = 'history-item-content';
                                    content.textContent = msg.content;
                                    
                                    historyItem.appendChild(content);
                                    
                                    // Add click handler to insert message into chat
                                    historyItem.addEventListener('click', () => {
                                        elements.input.value = msg.content;
                                        elements.input.focus();
                                    });
                                    
                                    elements.historyContent.appendChild(historyItem);
                                }
                            });
                        }
                    } else {
                        elements.historyContent.innerHTML = '<div class="history-item"><div class="history-item-content">Failed to load chat history.</div></div>';
                    }
                } catch (error) {
                    console.error('Error loading history:', error);
                    elements.historyContent.innerHTML = '<div class="history-item"><div class="history-item-content">Error loading chat history.</div></div>';
                }
            },

            init() {
                // Load history on page load
                this.loadHistory();
            }
        };

        // ===== Initialization =====
        document.addEventListener('DOMContentLoaded', () => {
            document.title = `ChatAI Session | ${state.sessionId}`;
            
            streamingToggle.init();
            formHandler.init();
            uploadManager.init();
            historyManager.init();
            modelManager.init();
            modelManager.loadModels();
            websocketManager.connect();
        });
    </script>
</body>
</html>
