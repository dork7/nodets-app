   // ===== Text-to-Speech Management =====
   const ttsManager = {
    audio: null,

    init() {
     elements.speakBtn.addEventListener('click', () => this.toggle());
    },

    toggle() {
     if (this.audio) {
      this.stop();
      return;
     }
     const text = elements.input.value.trim();
     if (!text) {
      elements.input.focus();
      return;
     }
     this.speak(text);
    },

    async speak(text) {
     elements.speakBtn.disabled = true;
     try {
      const res = await fetch(CONFIG.TTS_API_URL, {
       method: 'POST',
       headers: { 'Content-Type': 'application/json' },
       body: JSON.stringify({ text }),
      });
      const result = await res.json();
      if (result.success && result.responseObject) {
       const { audio, contentType } = result.responseObject;
       const binary = atob(audio);
       const bytes = new Uint8Array(binary.length);
       for (let i = 0; i < binary.length; i += 1) {
        bytes[i] = binary.charCodeAt(i);
       }
       const blob = new Blob([bytes], { type: contentType || 'audio/mpeg' });
       const url = URL.createObjectURL(blob);
       this.audio = new Audio(url);
       this.audio.addEventListener('ended', () => this.reset());
       this.audio.addEventListener('error', () => {
        this.reset();
        messageManager.append('System', 'Unable to play the generated audio.', 'system');
       });
       await this.audio.play();
       elements.speakBtn.classList.add('playing');
       elements.speakBtn.title = 'Stop';
      } else {
       messageManager.append('System', `Text-to-speech failed: ${result.message || 'Unknown error'}`, 'system');
      }
     } catch (error) {
      console.error('Text-to-speech request error:', error);
      messageManager.append('System', 'Text-to-speech request failed.', 'system');
     } finally {
      elements.speakBtn.disabled = false;
     }
    },

    stop() {
     if (this.audio) {
      this.audio.pause();
      this.audio.src = '';
      this.audio = null;
     }
     this.reset();
    },

    reset() {
     elements.speakBtn.classList.remove('playing');
     elements.speakBtn.title = 'Speak the message';
    },
   };

   // ===== Form Handling =====
   const formHandler = {
    init() {
     elements.form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Ignore submits (button click or Enter) while a socket response is in flight.
      if (state.isStreaming || elements.sendBtn.disabled) {
       return;
      }

      let message = elements.input.value.trim();

      if (message === '/new') {
       newChatManager.resetSession();
       return;
      }

      if (state.pastedCodeList.length > 0) {
       const pasted = state.pastedCodeList.join('\n\n');
       message = message ? `${message}\n\n${pasted}` : pasted;
      }
      const hasFiles = state.pendingFiles.length > 0;

      if ((!message && !hasFiles) || !state.socket) {
       return;
      }

      await uploadManager.waitForUploads();

      const uploaded = state.pendingFiles.filter((f) => f.status === 'uploaded');
      const images = uploaded.filter((f) => f.isImage);
      const files = uploaded.filter((f) => !f.isImage);
      const imageIds = images.map((f) => f.id);
      const fileIds = files.map((f) => f.id);

      websocketManager.send({
        sender: 'User',
        type: 'request',
        id: state.sessionId,
        method: 'chatAI',
        stream: state.streamingEnabled,
        rag: state.ragEnabled,
        ragDistance:
          state.ragEnabled && state.ragDistance !== '' && !Number.isNaN(Number(state.ragDistance))
            ? Number(state.ragDistance)
            : undefined,
        model: state.selectedModel,
        provider: state.selectedProvider,
        params: {
          prompt: message || (hasFiles ? 'Analyze the attached files.' : ''),
          imageIds: imageIds.length > 0 ? imageIds : undefined,
          imageId: imageIds.length === 1 ? imageIds[0] : undefined,
          fileIds: fileIds.length > 0 ? fileIds : undefined,
        },
       });

      messageManager.append('You', message || (hasFiles ? '(attachment)' : ''), 'user');
      images.forEach((img) =>
       messageManager.appendImage('You', {
        url: img.url,
        name: img.file.name,
       })
      );

      uploadManager.clearAll();
      codePreviewManager.clear();
      elements.input.value = '';
      // Block resubmits during the gap before the server's stream_start arrives.
      elements.sendBtn.disabled = true;
     });

     elements.stopBtn.addEventListener('click', () => {
      if (!state.isStreaming || !state.socket) {
       return;
      }

      websocketManager.send({
       sender: 'User',
       type: 'stop_stream',
       id: state.sessionId,
       method: 'chatAI',
      });
      utils.setStopButtonEnabled(false);
     });
    },
   };

// ===== Code Preview Management =====
   const codePreviewManager = {
    init() {
     elements.input.addEventListener('paste', (e) => this.handlePaste(e));
     elements.input.addEventListener('input', () => {
      if (!elements.input.value.trim() && state.pastedCodeList.length === 0) {
       this.clear();
      }
     });
    },

    handlePaste(e) {
     const text = e.clipboardData.getData('text/plain');
     if (!text || !this.isCode(text)) {
      return;
     }
     e.preventDefault();
     state.pastedCodeList.push(text.trim());
     elements.input.value = '';
     this.render();
    },

    isCode(text) {
     const t = text.trim();
     if (!t) return false;
     if (t.includes('\n')) {
      const codeLike =
       /[{}();=<>]/.test(t) ||
       /\b(function|const|let|var|return|import|export|class|def|if|for|while|async|await)\b/.test(t.toLowerCase());
      return codeLike;
     }
     return /[{}();=<>]/.test(t) && /[a-zA-Z0-9_]/.test(t);
    },

    clear() {
     state.pastedCodeList = [];
     elements.codePreview.hidden = true;
     elements.codePreview.innerHTML = '';
    },

    removeAt(index) {
     state.pastedCodeList.splice(index, 1);
     if (state.pastedCodeList.length === 0) {
      this.clear();
      return;
     }
     this.render();
    },

    render() {
     if (state.pastedCodeList.length === 0) {
      this.clear();
      return;
     }
     elements.codePreview.innerHTML = '';
     state.pastedCodeList.forEach((code, index) => {
      const lines = code.split('\n');
      const shown = lines.slice(0, 3);
      const truncated = lines.length > shown.length;

      const card = document.createElement('div');
      card.className = 'code-preview-card';
      card.innerHTML = `
       <div class="code-preview-header">
        <span class="code-preview-label">Pasted code ${index + 1}</span>
        <span class="code-preview-lines">${lines.length} line${lines.length === 1 ? '' : 's'}</span>
        <button type="button" class="code-preview-remove" aria-label="Remove pasted code" title="Remove">×</button>
       </div>
       <div class="code-preview-body"><pre>${this.escapeHtml(shown.join('\n'))}${truncated ? '\n…' : ''}</pre></div>
      `;
      card.querySelector('.code-preview-remove').addEventListener('click', () => {
       this.removeAt(index);
       elements.input.focus();
      });
      elements.codePreview.appendChild(card);
     });
     elements.codePreview.hidden = false;
    },

    escapeHtml(s) {
     return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    },
   };

   // ===== Upload Management =====
   const ACCEPTED_UPLOAD_TYPES = [
    'application/pdf',
    'application/msword',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
    'application/vnd.ms-excel',
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
    'text/csv',
    'text/plain',
    'text/markdown',
    'image/png',
    'image/jpeg',
    'image/gif',
    'image/webp',
    'image/svg+xml',
    'image/bmp',
    'image/x-icon',
    'image/tiff',
    'text/javascript',
    'application/javascript',
    'text/x-javascript',
    'text/typescript',
    'text/x-python',
    'text/x-c++src',
    'text/x-c++',
   ];

   const ACCEPTED_UPLOAD_EXTENSIONS = [
    '.pdf',
    '.doc',
    '.docx',
    '.xls',
    '.xlsx',
    '.csv',
    '.txt',
    '.md',
    '.png',
    '.jpg',
    '.jpeg',
    '.gif',
    '.webp',
    '.svg',
    '.bmp',
    '.ico',
    '.tiff',
    '.tif',
    '.js',
    '.jsx',
    '.mjs',
    '.cjs',
    '.ts',
    '.tsx',
    '.py',
    '.cpp',
    '.cc',
    '.cxx',
    '.hpp',
   ];

   const uploadManager = {
    init() {
     elements.uploadBtn.addEventListener('click', () => {
      elements.fileInput.value = '';
      elements.fileInput.click();
     });

     elements.fileInput.addEventListener('change', () => {
      if (elements.fileInput.files && elements.fileInput.files.length > 0) {
       this.addFiles(Array.from(elements.fileInput.files));
      }
      elements.fileInput.value = '';
     });

     ['dragenter', 'dragover'].forEach((eventName) => {
      elements.chatContainer.addEventListener(eventName, (e) => {
       e.preventDefault();
       elements.dropOverlay.classList.add('active');
      });
     });

     ['dragleave', 'drop'].forEach((eventName) => {
      elements.chatContainer.addEventListener(eventName, (e) => {
       e.preventDefault();
       elements.dropOverlay.classList.remove('active');
      });
     });

     elements.chatContainer.addEventListener('drop', (e) => {
      e.preventDefault();
      const files = e.dataTransfer && e.dataTransfer.files ? Array.from(e.dataTransfer.files) : [];
      if (files.length > 0) {
       this.addFiles(files);
      }
     });
    },

    addFiles(files) {
     const acceptedFiles = files.filter((file) => this.canAddFile(file));
     const remainingSlots = CONFIG.MAX_FILES - state.pendingFiles.length;
     if (remainingSlots <= 0 || acceptedFiles.length === 0) {
      return;
     }
     acceptedFiles.slice(0, remainingSlots).forEach((file) => this.addFile(file));
     if (acceptedFiles.length > remainingSlots) {
      messageManager.append(
       'System',
       `Only ${CONFIG.MAX_FILES} files are allowed per message. ${acceptedFiles.length - remainingSlots} file(s) skipped.`,
       'system'
      );
     }
    },

    canAddFile(file) {
     if (file.size > CONFIG.MAX_FILE_SIZE) {
      messageManager.append(
       'System',
       `File "${file.name}" exceeds the ${Math.round(CONFIG.MAX_FILE_SIZE / 1024 / 1024)} MB size limit.`,
       'system'
      );
      return false;
     }

     const lowerName = file.name.toLowerCase();
     const hasAcceptedType = ACCEPTED_UPLOAD_TYPES.includes(file.type);
     const hasAcceptedExtension = ACCEPTED_UPLOAD_EXTENSIONS.some((ext) => lowerName.endsWith(ext));

     if (!hasAcceptedType && !hasAcceptedExtension) {
      messageManager.append(
       'System',
       `"${file.name}" is not a supported file. Only PDF, Word, Excel, image, and code files (JS, TS, Python, C++) are allowed.`,
       'system'
      );
      return false;
     }

     return true;
    },

    addFile(file) {
     if (state.pendingFiles.length >= CONFIG.MAX_FILES) {
      messageManager.append('System', `Only ${CONFIG.MAX_FILES} files are allowed per message.`, 'system');
      return;
     }

     const entry = {
      file,
      name: file.name,
      isImage: file.type.startsWith('image/'),
      status: 'uploading',
      id: null,
      url: null,
      xhr: null,
     };

     state.pendingFiles.push(entry);
     this.renderChip(entry);
     this.uploadFile(entry);
    },

    renderChip(entry) {
     const chip = document.createElement('div');
     chip.className = 'attachment-chip uploading';

     const preview = document.createElement('div');
     preview.className = `attachment-chip-preview${entry.isImage ? '' : ' file'}`;

if (entry.isImage) {
      const base = this.imageDataSrc(entry.file);
      this.setPreviewImage(preview, base);
     } else {
      const ext = (entry.name.split('.').pop() || 'FILE').slice(0, 4).toUpperCase();
      preview.textContent = ext;
     }
     chip.appendChild(preview);

     const name = document.createElement('span');
     name.className = 'attachment-chip-name';
     name.textContent = entry.name;
     name.title = entry.name;
     chip.appendChild(name);

     const status = document.createElement('span');
     status.className = 'attachment-chip-status uploading';
     status.textContent = 'Uploading';
     chip.appendChild(status);

     const removeBtn = document.createElement('button');
     removeBtn.type = 'button';
     removeBtn.className = 'attachment-chip-remove';
     removeBtn.title = 'Remove';
     removeBtn.textContent = '×';
     removeBtn.addEventListener('click', () => this.removeFile(entry));
     chip.appendChild(removeBtn);

     entry.chip = chip;
     entry.statusEl = status;
     elements.inputAttachments.appendChild(chip);
     return chip;
    },

imageDataSrc(file) {
      try {
       return URL.createObjectURL(file);
      } catch (e) {
       return '';
      }
     },

     setPreviewImage(preview, url) {
      const img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.addEventListener('load', () => URL.revokeObjectURL(url), { once: true });
      preview.appendChild(img);
     },

    updateFile(entry) {
     if (!entry.chip) return;
     entry.chip.classList.remove('uploading', 'error');
     if (entry.status === 'error') entry.chip.classList.add('error');
     if (entry.statusEl) {
      entry.statusEl.className = `attachment-chip-status${entry.status === 'error' ? ' error' : ''}`;
      entry.statusEl.textContent = entry.status === 'error' ? 'Failed' : 'Attached';
     }
    },

    removeFile(entry) {
     if (entry.xhr) {
      entry.xhr.abort();
     }
     entry._onSettled?.();
     entry.chip?.remove();
     const index = state.pendingFiles.indexOf(entry);
     if (index !== -1) {
      state.pendingFiles.splice(index, 1);
     }
    },

    clearAll() {
     state.pendingFiles.forEach((entry) => {
      entry.xhr?.abort();
      entry.chip?.remove();
     });
     state.pendingFiles = [];
     if (elements.inputAttachments) {
      elements.inputAttachments.innerHTML = '';
     }
    },

    async waitForUploads() {
     const inFlight = state.pendingFiles.filter((f) => f.status === 'uploading');
     if (inFlight.length === 0) {
      return;
     }

     const settle = (entry) =>
      new Promise((resolve) => {
       const check = () => resolve();
       if (entry.status !== 'uploading') {
        check();
       } else {
        entry._onSettled = check;
       }
      });

     await Promise.all(inFlight.map(settle));
    },

    uploadFile(entry) {
     const formData = new FormData();
     formData.append('file', entry.file);

     const xhr = new XMLHttpRequest();
     entry.xhr = xhr;
     xhr.open('POST', CONFIG.UPLOAD_API_URL);

     xhr.onload = () => {
      try {
       const result = JSON.parse(xhr.responseText);
       if (xhr.status >= 200 && xhr.status < 300 && result.success && result.responseObject) {
        const uploaded = result.responseObject;
        entry.id = uploaded.id;
        entry.url = uploaded.url;
        entry.status = 'uploaded';
        this.updateFile(entry);
        messageManager.append('System', `File URL: ${uploaded.url}`, 'system');
       } else {
        entry.status = 'error';
        this.updateFile(entry);
        messageManager.append('System', `Upload failed: ${result.message || `HTTP ${xhr.status}`}`, 'system');
       }
      } catch (error) {
       console.error('Error parsing upload response:', error);
       entry.status = 'error';
       this.updateFile(entry);
       messageManager.append('System', `Upload failed: unexpected server response.`, 'system');
      }
      entry._onSettled?.();
     };

     xhr.onerror = () => {
      entry.status = 'error';
      this.updateFile(entry);
      messageManager.append('System', `Upload failed: network error for "${entry.name}".`, 'system');
      entry._onSettled?.();
     };

     xhr.send(formData);
    },
   };

