    async uploadFiles(fileList) {
     const files = Array.from(fileList);
     if (files.length === 0) return;

     const btnWasDisabled = elements.ragFilesUploadBtn.disabled;
     elements.ragFilesUploadBtn.disabled = true;
     const originalText = elements.ragFilesUploadBtn.textContent;

     let uploaded = 0;
     let failed = 0;

     for (const [index, file] of files.entries()) {
      elements.ragFilesUploadBtn.textContent =
       files.length > 1 ? `Uploading ${index + 1}/${files.length}...` : 'Uploading...';

      const formData = new FormData();
      formData.append('file', file);
      formData.append('bucket', CONFIG.RAG_BUCKET);

      try {
       const res = await fetch(CONFIG.UPLOAD_API_URL, { method: 'POST', body: formData });
       const result = await res.json();
       if (result.success) {
        uploaded += 1;
       } else {
        failed += 1;
        console.error('RAG upload failed:', result.message);
       }
      } catch (error) {
       failed += 1;
       console.error('RAG upload error:', error);
      }
     }

     elements.ragFilesUploadBtn.disabled = btnWasDisabled;
     elements.ragFilesUploadBtn.textContent = originalText;

     if (uploaded > 0) {
      messageManager.append(
       'System',
       `Uploaded ${uploaded} file${uploaded === 1 ? '' : 's'} to RAG knowledge base.`,
       'system'
      );
      await this.loadFiles();
     }
     if (failed > 0) {
      messageManager.append('System', `${failed} file${failed === 1 ? '' : 's'} failed to upload.`, 'system');
     }
