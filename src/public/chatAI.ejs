      const apiBase = CONFIG.RAG_FILES_API_URL.replace(/\/files$/, '');
      const res = await fetch(
       `${apiBase}/${encodeURIComponent(file.id)}?bucket=${encodeURIComponent(CONFIG.RAG_BUCKET)}`,
       { method: 'DELETE' }
