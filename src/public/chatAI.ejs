      await uploadManager.waitForUploads();

      const uploaded = state.pendingFiles.filter((f) => f.status === 'uploaded');
      const images = uploaded.filter((f) => f.isImage);
      const files = uploaded.filter((f) => !f.isImage);
      const imageIds = images.map((f) => f.id);
      const fileIds = files.map((f) => f.id);

      websocketManager.send({
        sender: 'User',
        type: 'request',
        id: state.sessionId,
        method: 'chatAI',
        stream: state.streamingEnabled,
        model: state.selectedModel,
        params: {
          prompt: message || (hasFiles ? 'Analyze the attached files.' : ''),
          imageIds: imageIds.length > 0 ? imageIds : undefined,
          imageId: imageIds.length === 1 ? imageIds[0] : undefined,
          fileIds: fileIds.length > 0 ? fileIds : undefined,
        },
      });

      messageManager.append('You', message || (hasFiles ? '(attachment)' : ''), 'user');
      images.forEach((img) =>
       messageManager.appendImage('You', {
        url: img.url,
        name: img.file.name,
       })
      );

      uploadManager.clearAll();
      elements.input.value = '';
     });

     elements.stopBtn.addEventListener('click', () => {
      if (!state.isStreaming || !state.socket) {
       return;
      }

      websocketManager.send({
       sender: 'User',
       type: 'stop_stream',
       id: state.sessionId,
       method: 'chatAI',
      });
      utils.setStopButtonEnabled(false);
     });
    },
   };

   // ===== Upload Management =====
   const ACCEPTED_UPLOAD_TYPES = [
    'application/pdf',
    'application/msword',
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
    'application/vnd.ms-excel',
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
    'text/csv',
    'image/png',
    'image/jpeg',
    'image/gif',
    'image/webp',
    'image/svg+xml',
    'image/bmp',
    'image/x-icon',
    'image/tiff',
    'text/javascript',
    'application/javascript',
    'text/x-javascript',
    'text/typescript',
    'text/x-python',
    'text/x-c++src',
    'text/x-c++',
   ];

   const ACCEPTED_UPLOAD_EXTENSIONS = [
    '.pdf',
    '.doc',
    '.docx',
    '.xls',
    '.xlsx',
    '.csv',
    '.png',
    '.jpg',
    '.jpeg',
    '.gif',
    '.webp',
    '.svg',
    '.bmp',
    '.ico',
    '.tiff',
    '.tif',
    '.js',
    '.jsx',
    '.mjs',
    '.cjs',
    '.ts',
    '.tsx',
    '.py',
    '.cpp',
    '.cc',
    '.cxx',
    '.hpp',
   ];

   const uploadManager = {
    init() {
     elements.uploadBtn.addEventListener('click', () => {
      elements.fileInput.value = '';
      elements.fileInput.click();
     });

     elements.fileInput.addEventListener('change', () => {
      if (elements.fileInput.files && elements.fileInput.files.length > 0) {
       this.addFiles(Array.from(elements.fileInput.files));
      }
      elements.fileInput.value = '';
     });

     ['dragenter', 'dragover'].forEach((eventName) => {
      elements.chatContainer.addEventListener(eventName, (e) => {
       e.preventDefault();
       elements.dropOverlay.classList.add('active');
      });
     });

     ['dragleave', 'drop'].forEach((eventName) => {
      elements.chatContainer.addEventListener(eventName, (e) => {
       e.preventDefault();
       elements.dropOverlay.classList.remove('active');
      });
     });

     elements.chatContainer.addEventListener('drop', (e) => {
      e.preventDefault();
      const files = e.dataTransfer && e.dataTransfer.files ? Array.from(e.dataTransfer.files) : [];
      if (files.length > 0) {
       this.addFiles(files);
      }
     });
    },

    addFiles(files) {
     const acceptedFiles = files.filter((file) => this.canAddFile(file));
     const remainingSlots = CONFIG.MAX_FILES - state.pendingFiles.length;
     if (remainingSlots <= 0 || acceptedFiles.length === 0) {
      return;
     }
     acceptedFiles.slice(0, remainingSlots).forEach((file) => this.addFile(file));
     if (acceptedFiles.length > remainingSlots) {
      messageManager.append(
       'System',
       `Only ${CONFIG.MAX_FILES} files are allowed per message. ${acceptedFiles.length - remainingSlots} file(s) skipped.`,
       'system'
      );
     }
    },

    canAddFile(file) {
     if (file.size > CONFIG.MAX_FILE_SIZE) {
      messageManager.append(
       'System',
       `File "${file.name}" exceeds the ${Math.round(CONFIG.MAX_FILE_SIZE / 1024 / 1024)} MB size limit.`,
       'system'
      );
      return false;
     }

     const lowerName = file.name.toLowerCase();
     const hasAcceptedType = ACCEPTED_UPLOAD_TYPES.includes(file.type);
     const hasAcceptedExtension = ACCEPTED_UPLOAD_EXTENSIONS.some((ext) => lowerName.endsWith(ext));

     if (!hasAcceptedType && !hasAcceptedExtension) {
      messageManager.append(
       'System',
       `"${file.name}" is not a supported file. Only PDF, Word, Excel, image, and code files (JS, TS, Python, C++) are allowed.`,
       'system'
      );
      return false;
     }

     return true;
    },

    addFile(file) {
     if (state.pendingFiles.length >= CONFIG.MAX_FILES) {
      messageManager.append('System', `Only ${CONFIG.MAX_FILES} files are allowed per message.`, 'system');
      return;
     }

     const entry = {
      file,
      name: file.name,
      isImage: file.type.startsWith('image/'),
      status: 'uploading',
      id: null,
      url: null,
      xhr: null,
     };

     state.pendingFiles.push(entry);
     this.renderChip(entry);
     this.uploadFile(entry);
    },

    renderChip(entry) {
     const chip = document.createElement('div');
     chip.className = 'attachment-chip uploading';

     const preview = document.createElement('div');
     preview.className = `attachment-chip-preview${entry.isImage ? '' : ' file'}`;

if (entry.isImage) {
      const base = this.imageDataSrc(entry.file);
      this.setPreviewImage(preview, base);
     } else {
      const ext = (entry.name.split('.').pop() || 'FILE').slice(0, 4).toUpperCase();
      preview.textContent = ext;
     }
     chip.appendChild(preview);

     const name = document.createElement('span');
     name.className = 'attachment-chip-name';
     name.textContent = entry.name;
     name.title = entry.name;
     chip.appendChild(name);

     const status = document.createElement('span');
     status.className = 'attachment-chip-status uploading';
     status.textContent = 'Uploading';
     chip.appendChild(status);

     const removeBtn = document.createElement('button');
     removeBtn.type = 'button';
     removeBtn.className = 'attachment-chip-remove';
     removeBtn.title = 'Remove';
     removeBtn.textContent = '×';
     removeBtn.addEventListener('click', () => this.removeFile(entry));
     chip.appendChild(removeBtn);

     entry.chip = chip;
     entry.statusEl = status;
     elements.inputAttachments.appendChild(chip);
     return chip;
    },

imageDataSrc(file) {
      try {
       return URL.createObjectURL(file);
      } catch (e) {
       return '';
      }
     },

     setPreviewImage(preview, url) {
      const img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.addEventListener('load', () => URL.revokeObjectURL(url), { once: true });
      preview.appendChild(img);
     },

    updateFile(entry) {
     if (!entry.chip) return;
     entry.chip.classList.remove('uploading', 'error');
     if (entry.status === 'error') entry.chip.classList.add('error');
     if (entry.statusEl) {
      entry.statusEl.className = `attachment-chip-status${entry.status === 'error' ? ' error' : ''}`;
      entry.statusEl.textContent = entry.status === 'error' ? 'Failed' : 'Attached';
     }
    },

    removeFile(entry) {
     if (entry.xhr) {
      entry.xhr.abort();
     }
     entry._onSettled?.();
     entry.chip?.remove();
     const index = state.pendingFiles.indexOf(entry);
     if (index !== -1) {
      state.pendingFiles.splice(index, 1);
     }
    },

    clearAll() {
     state.pendingFiles.forEach((entry) => {
      entry.xhr?.abort();
      entry.chip?.remove();
     });
     state.pendingFiles = [];
     if (elements.inputAttachments) {
      elements.inputAttachments.innerHTML = '';
     }
    },

    async waitForUploads() {
     const inFlight = state.pendingFiles.filter((f) => f.status === 'uploading');
     if (inFlight.length === 0) {
      return;
     }

     const settle = (entry) =>
      new Promise((resolve) => {
       const check = () => resolve();
       if (entry.status !== 'uploading') {
        check();
       } else {
        entry._onSettled = check;
       }
      });

     await Promise.all(inFlight.map(settle));
    },

    uploadFile(entry) {
     const formData = new FormData();
     formData.append('file', entry.file);

     const xhr = new XMLHttpRequest();
     entry.xhr = xhr;
     xhr.open('POST', CONFIG.UPLOAD_API_URL);

     xhr.onload = () => {
      try {
       const result = JSON.parse(xhr.responseText);
       if (xhr.status >= 200 && xhr.status < 300 && result.success && result.responseObject) {
        const uploaded = result.responseObject;
        entry.id = uploaded.id;
        entry.url = uploaded.url;
        entry.status = 'uploaded';
        this.updateFile(entry);
        messageManager.append('System', `File URL: ${uploaded.url}`, 'system');
       } else {
        entry.status = 'error';
        this.updateFile(entry);
        messageManager.append('System', `Upload failed: ${result.message || `HTTP ${xhr.status}`}`, 'system');
       }
      } catch (error) {
       console.error('Error parsing upload response:', error);
       entry.status = 'error';
       this.updateFile(entry);
       messageManager.append('System', `Upload failed: unexpected server response.`, 'system');
      }
      entry._onSettled?.();
     };

     xhr.onerror = () => {
      entry.status = 'error';
      this.updateFile(entry);
      messageManager.append('System', `Upload failed: network error for "${entry.name}".`, 'system');
      entry._onSettled?.();
     };

     xhr.send(formData);
    },
   };

   // ===== History Management =====
   const historyManager = {
    historyItems: [],

    async loadHistory() {
     if (!elements.historyContent) return;

     try {
      const response = await fetch(`${CONFIG.HISTORY_API_URL}/${state.sessionId}`);
      const data = await response.json();
      const success = data.success && Array.isArray(data.responseObject);
      this.historyItems = success ? data.responseObject.filter((msg) => msg.role === 'user' && msg.content) : [];
      this.renderPanel();
      this.renderSheet();
      if (!success) {
       elements.historyContent.innerHTML =
        '<div class="history-item"><div class="history-item-content">Failed to load chat history.</div></div>';
      }
     } catch (error) {
      console.error('Error loading history:', error);
      this.historyItems = [];
      this.renderSheet();
      elements.historyContent.innerHTML =
       '<div class="history-item"><div class="history-item-content">Error loading chat history.</div></div>';
     }
    },

    renderPanel() {
     elements.historyContent.innerHTML = '';
     if (this.historyItems.length === 0) {
      elements.historyContent.innerHTML =
       '<div class="history-item"><div class="history-item-content">No chat history found.</div></div>';
      return;
     }
     this.historyItems.forEach((msg) => elements.historyContent.appendChild(this.createItem(msg.content)));
    },

    renderSheet() {
     if (!elements.historySheetBody) return;
     elements.historySheetBody.innerHTML = '';
     if (this.historyItems.length === 0) {
      elements.historySheetBody.innerHTML =
       '<div class="history-item"><div class="history-item-content">No chat history found.</div></div>';
      elements.historySheetCount.textContent = '0 messages';
      return;
     }
     this.historyItems.forEach((msg) => elements.historySheetBody.appendChild(this.createItem(msg.content)));
     elements.historySheetCount.textContent = `${this.historyItems.length} message${this.historyItems.length === 1 ? '' : 's'}`;
    },

    createItem(content) {
     const historyItem = document.createElement('div');
     historyItem.className = 'history-item';

     const contentEl = document.createElement('div');
     contentEl.className = 'history-item-content';
     contentEl.textContent = content;

     historyItem.appendChild(contentEl);

     historyItem.addEventListener('click', () => {
      elements.input.value = content;
      elements.input.focus();
     });

     return historyItem;
    },

    init() {
     this.loadHistory();
     this.bindSheet();

     elements.clearHistoryBtn?.addEventListener('click', () => {
      this.openConfirmModal();
     });

     elements.historySheetClearBtn?.addEventListener('click', () => {
      this.openConfirmModal();
     });
    },

    bindSheet() {
     elements.historyViewAllBtn?.addEventListener('click', () => {
      this.renderSheet();
      this.openSheet();
     });

     elements.historySheetClose?.addEventListener('click', () => this.closeSheet());

     elements.historySheetOverlay?.addEventListener('click', (e) => {
      if (e.target === elements.historySheetOverlay) {
       this.closeSheet();
      }
     });

     document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && elements.historySheetOverlay && !elements.historySheetOverlay.hidden) {
       this.closeSheet();
      }
     });
    },

    openSheet() {
     elements.historySheetOverlay.hidden = false;
     setTimeout(() => elements.historySheetOverlay.classList.add('open'), 10);
    },

    closeSheet() {
     elements.historySheetOverlay.classList.remove('open');
     setTimeout(() => {
      elements.historySheetOverlay.hidden = true;
     }, 250);
    },

    openConfirmModal() {
      if (!elements.confirmModal) {
       return;
      }
      elements.confirmModal.hidden = false;
     },

     closeConfirmModal() {
      if (!elements.confirmModal) {
       return;
      }
      elements.confirmModal.hidden = true;
     },

     initConfirmModal() {
      if (!elements.confirmModal) {
       return;
      }

      elements.confirmModalClose?.addEventListener('click', () => this.closeConfirmModal());
      elements.confirmModalNo?.addEventListener('click', () => this.closeConfirmModal());
      elements.confirmModalYes?.addEventListener('click', () => {
       this.closeConfirmModal();
       this.clearHistory();
      });

      elements.confirmModal.addEventListener('click', (e) => {
       if (e.target === elements.confirmModal) {
        this.closeConfirmModal();
       }
      });

      document.addEventListener('keydown', (e) => {
       if (e.key === 'Escape' && elements.confirmModal && !elements.confirmModal.hidden) {
        this.closeConfirmModal();
       }
      });
     },

     async clearHistory() {
      elements.clearHistoryBtn.disabled = true;
      const originalText = elements.clearHistoryBtn.textContent;
      elements.clearHistoryBtn.textContent = 'Clearing...';

      try {
       const res = await fetch(`${CONFIG.HISTORY_API_URL}/${state.sessionId}`, { method: 'DELETE' });
       const data = await res.json();
       if (data.success) {
        this.historyItems = [];
        this.renderPanel();
        this.renderSheet();
        elements.messages.innerHTML = '';
        elements.input.value = '';
        totalTokenUsageManager.load();
       } else {
        console.error('Failed to clear history:', data.message);
       }
      } catch (error) {
       console.error('Error clearing history:', error);
      } finally {
       elements.clearHistoryBtn.disabled = false;
       elements.clearHistoryBtn.textContent = originalText;
      }
     },
    };

   // ===== New Chat Management =====
   const newChatManager = {
    resetSession() {
     state.sessionId = `sess-${Math.random().toString(36).substr(2, 9)}`;
     localStorage.setItem('chatSessionId', state.sessionId);
elements.messages.innerHTML = '';
      elements.input.value = '';
      uploadManager.clearAll();
      state.combinedContent = '';
     document.title = `ChatAI Session | ${state.sessionId}`;
     totalTokenUsageManager.load();
     historyManager.loadHistory();
    },

    init() {
     elements.newChatBtn.addEventListener('click', () => {
      this.resetSession();
     });
    },
   };

   // ===== RAG Files Management =====
   const ragManager = {
    files: [],

    async loadFiles() {
     try {
      const res = await fetch(CONFIG.RAG_FILES_API_URL);
      const result = await res.json();
      this.files = Array.isArray(result.responseObject)
       ? result.responseObject.filter((f) => f.bucket === CONFIG.RAG_BUCKET)
       : [];
      this.renderPanel();
      this.renderModal();
     } catch (error) {
      console.error('Error loading RAG files:', error);
     }
    },

    displayName(file) {
     return file.name.replace(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}-/, '');
    },

    createItem(file) {
     const item = document.createElement('div');
     item.className = 'history-item';
     item.title = file.url || '';

     const content = document.createElement('div');
     content.className = 'history-item-content';
     content.textContent = this.displayName(file);
     item.appendChild(content);

     const time = document.createElement('div');
     time.className = 'history-item-time';
     time.textContent = utils.formatFileSize(file.size);
     item.appendChild(time);

     item.addEventListener('click', () => {
      if (file.url) window.open(file.url, '_blank');
     });

     return item;
    },

    renderPanel() {
     if (!elements.ragContent) return;
     elements.ragContent.innerHTML = '';

     const addItem = document.createElement('div');
     addItem.className = 'history-item rag-add-item';
     addItem.title = 'Add files to RAG';
     const addLabel = document.createElement('div');
     addLabel.className = 'history-item-content';
     addLabel.textContent = '+ Add Files';
     addItem.appendChild(addLabel);
     addItem.addEventListener('click', () => {
      this.loadFiles();
      this.openModal();
     });
     elements.ragContent.appendChild(addItem);

     if (this.files.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'history-item';
      const emptyContent = document.createElement('div');
      emptyContent.className = 'history-item-content';
      emptyContent.textContent = 'No RAG files uploaded.';
      empty.appendChild(emptyContent);
      elements.ragContent.appendChild(empty);
      return;
     }
     this.files.slice(0, 5).forEach((file) => elements.ragContent.appendChild(this.createItem(file)));
    },

    renderModal() {
     if (!elements.ragFilesList) return;
     elements.ragFilesList.innerHTML = '';
     if (this.files.length === 0) {
      elements.ragFilesList.innerHTML =
       '<div class="history-item"><div class="history-item-content">No RAG files uploaded.</div></div>';
      elements.ragFilesModalCount.textContent = '0 files';
      return;
     }
     this.files.forEach((file) => elements.ragFilesList.appendChild(this.createItem(file)));
     elements.ragFilesModalCount.textContent = `${this.files.length} file${this.files.length === 1 ? '' : 's'}`;
    },

    openModal() {
     elements.ragFilesModal.hidden = false;
     this.renderModal();
    },

    closeModal() {
     elements.ragFilesModal.hidden = true;
    },

    async uploadFiles(fileList) {
     const files = Array.from(fileList);
     if (files.length === 0) return;

     const btnWasDisabled = elements.ragFilesUploadBtn.disabled;
     elements.ragFilesUploadBtn.disabled = true;
     const originalText = elements.ragFilesUploadBtn.textContent;
     elements.ragFilesUploadBtn.textContent = 'Uploading...';

     let uploaded = 0;
     let failed = 0;

     for (const file of files) {
      const formData = new FormData();
      formData.append('file', file);
      formData.append('bucket', CONFIG.RAG_BUCKET);

      try {
       const res = await fetch(CONFIG.UPLOAD_API_URL, { method: 'POST', body: formData });
       const result = await res.json();
       if (result.success) {
        uploaded += 1;
       } else {
        failed += 1;
        console.error('RAG upload failed:', result.message);
       }
      } catch (error) {
       failed += 1;
       console.error('RAG upload error:', error);
      }
     }

     elements.ragFilesUploadBtn.disabled = btnWasDisabled;
     elements.ragFilesUploadBtn.textContent = originalText;

     if (uploaded > 0) {
      messageManager.append(
       'System',
       `Uploaded ${uploaded} file${uploaded === 1 ? '' : 's'} to RAG knowledge base.`,
       'system'
      );
      await this.loadFiles();
     }
     if (failed > 0) {
      messageManager.append('System', `${failed} file${failed === 1 ? '' : 's'} failed to upload.`, 'system');
     }
    },

    async uploadSelected() {
     const files = elements.ragFileInput.files;
     if (!files || files.length === 0) return;
     await this.uploadFiles(files);
     elements.ragFileInput.value = '';
    },

    bindDragDrop(element, highlightEl) {
     if (!element || !highlightEl) return;
     let depth = 0;

     element.addEventListener('dragenter', (e) => {
      e.preventDefault();
      depth += 1;
      highlightEl.classList.add('dragover');
     });

     element.addEventListener('dragover', (e) => e.preventDefault());

     element.addEventListener('dragleave', () => {
      depth = Math.max(0, depth - 1);
      if (depth === 0) {
       highlightEl.classList.remove('dragover');
      }
     });

     element.addEventListener('drop', (e) => {
      e.preventDefault();
      depth = 0;
      highlightEl.classList.remove('dragover');
      const files = e.dataTransfer && e.dataTransfer.files ? Array.from(e.dataTransfer.files) : [];
      if (files.length > 0) {
       this.uploadFiles(files);
      }
     });
    },

    init() {
     elements.ragViewAllBtn?.addEventListener('click', () => {
      this.loadFiles();
      this.openModal();
     });

     elements.ragFilesModalClose?.addEventListener('click', () => this.closeModal());

     elements.ragFilesModal?.addEventListener('click', (e) => {
      if (e.target === elements.ragFilesModal) {
       this.closeModal();
      }
     });

     document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && elements.ragFilesModal && !elements.ragFilesModal.hidden) {
       this.closeModal();
      }
     });

     elements.ragFilesUploadBtn?.addEventListener('click', () => this.uploadSelected());

     this.bindDragDrop(elements.ragFilesModal, elements.ragFilesDialog);
     this.bindDragDrop(elements.ragPanel, elements.ragPanel);

     this.loadFiles();
    },
   };

   // ===== Initialization =====
   document.addEventListener('DOMContentLoaded', () => {
    localStorage.setItem('chatSessionId', state.sessionId);
    document.title = `ChatAI Session | ${state.sessionId}`;

    streamingToggle.init();
    formHandler.init();
    ttsManager.init();
    uploadManager.init();
    historyManager.init();
    historyManager.initConfirmModal();
    modelManager.init();
    modelManager.loadModels();
    totalTokenUsageManager.load();
    websocketManager.connect();
    newChatManager.init();
    ragManager.init();
   });

  </script>
 </body>
</html>
