         placeholder="Type your message..."
        />
        <button type="button" id="speak-btn" class="speak-btn" title="Speak the message" aria-label="Speak the message">
         <svg class="icon-speak" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
