<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8" />
  <title>ChatAI Session</title>
   <style>
    /* ===== OpenCode terminal theme — near-black, monochrome, hairlines ===== */
    :root {
     --bg: #0a0a0a;
     --bg-raised: #121212;
     --bg-inset: #1a1a1a;
     --bg-deep: #1f1f1f;

     --border: #262626;
     --border-strong: #3a3a3a;

     --fg: #ededed;
     --fg-muted: #9a9a9a;
     --fg-faint: #5c5c5c;

     --accent: #fafafa;
     --on-accent: #0a0a0a;
     --accent-soft: #b9b9b9;

     --success: #3fb950;
     --warn: #d29922;
     --danger: #f85149;
     --info: #58a6ff;

     --font-mono: "Geist Mono", "Berkeley Mono", "JetBrains Mono", ui-monospace,
      "SF Mono", "Cascadia Code", "Roboto Mono", Menlo, Consolas, monospace;
     --font-sans: "Geist", ui-sans-serif, -apple-system, "Segoe UI", Roboto, sans-serif;

     --radius: 6px;
     --radius-sm: 4px;
    }

    /* ===== Base ===== */
    * {
     box-sizing: border-box;
    }

    ::selection {
     background: var(--accent);
     color: var(--on-accent);
    }

    body {
     background: var(--bg);
     color: var(--fg);
     font-family: var(--font-mono);
     margin: 0;
     height: 100vh;
     overflow: hidden;
     display: flex;
     flex-direction: column;
    }

    a {
     color: var(--info);
     text-decoration: underline;
     transition: opacity 0.2s;
    }

    a:hover {
     opacity: 0.8;
    }

    :focus-visible {
     outline: 1px solid var(--accent);
     outline-offset: 2px;
    }

    /* ===== Header ===== */
    .app-header {
     background: var(--bg);
     border-bottom: 1px solid var(--border);
     flex-shrink: 0;
    }

    .app-header-inner {
     width: 100%;
     margin: 0 auto;
     padding: 18px 24px;
     display: flex;
     align-items: baseline;
     gap: 16px;
    }

    .app-brand {
     display: flex;
     align-items: baseline;
     gap: 12px;
    }

    .app-wordmark {
     font-family: var(--font-mono);
     font-size: 1.3em;
     font-weight: 600;
     color: var(--fg);
     letter-spacing: -0.01em;
    }

    .app-sub {
     color: var(--fg-faint);
     font-size: 0.66em;
     text-transform: uppercase;
     letter-spacing: 0.14em;
     user-select: none;
    }

    .app-header-meta {
     margin-left: auto;
     color: var(--fg-faint);
     font-size: 0.66em;
     text-transform: uppercase;
     letter-spacing: 0.08em;
     user-select: none;
     font-variant-numeric: tabular-nums;
    }

    /* ===== Main ===== */
    #main-container {
     flex: 1;
     min-height: 0;
     width: 100%;
     margin: 16px auto 0;
     padding: 0 24px 24px;
     display: flex;
     flex-direction: column;
    }

    /* ===== Chat Container ===== */
    #chat-container {
     position: relative;
     background: var(--bg);
     min-width: 0;
     min-height: 0;
     flex: 1;
     border-radius: var(--radius);
     border: 1px solid var(--border);
     padding: 18px;
     display: flex;
     flex-direction: column;
    }

    /* ===== History Panel ===== */
    #history-panel {
     flex-shrink: 0;
     min-width: 0;
     overflow: hidden;
     background: var(--bg-raised);
     border-radius: var(--radius);
     border: 1px solid var(--border);
     display: flex;
     align-items: center;
     gap: 16px;
     margin: 0 24px 14px;
     padding: 10px 16px;
    }

    #history-panel-header {
     display: flex;
     align-items: center;
     gap: 10px;
     flex-shrink: 0;
    }

#history-panel-title {
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--fg);
      margin: 0;
     }

    #history-panel-title::before {
     content: none;
    }

    #history-view-all-btn {
     background: transparent;
     color: var(--fg-muted);
     border: 1px solid var(--border);
     border-radius: var(--radius-sm);
     padding: 3px 10px;
     font-size: 0.72em;
     font-family: var(--font-mono);
     text-transform: uppercase;
     letter-spacing: 0.06em;
     cursor: pointer;
     transition: all 0.2s;
     flex-shrink: 0;
     margin-left: auto;
     white-space: nowrap;
    }

    #history-view-all-btn:hover {
     color: var(--fg);
     border-color: var(--border-strong);
     background: var(--bg-deep);
    }

    /* ===== RAG Panel ===== */
    #rag-panel {
     flex-shrink: 0;
     min-width: 0;
     overflow: hidden;
     background: var(--bg-raised);
     border-radius: var(--radius);
     border: 1px solid var(--border);
     display: flex;
     align-items: center;
     gap: 16px;
     margin: 0 24px 14px;
     padding: 10px 16px;
    }

    #rag-panel-header {
     display: flex;
     align-items: center;
     gap: 10px;
     flex-shrink: 0;
    }

    #rag-panel-title {
     font-family: var(--font-mono);
     font-size: 11px;
     font-weight: 500;
     text-transform: uppercase;
     letter-spacing: 0.08em;
     color: var(--fg);
     margin: 0;
    }

    #rag-content {
     display: flex;
     align-items: center;
     gap: 8px;
     flex: 1;
     min-width: 0;
     overflow: hidden;
    }

    #rag-panel:hover {
     border-color: var(--border-strong);
    }

    #rag-panel.dragover {
     border-color: var(--accent);
     background: var(--bg-inset);
    }

    #rag-view-all-btn {
     background: transparent;
     color: var(--fg-muted);
     border: 1px solid var(--border);
     border-radius: var(--radius-sm);
     padding: 3px 10px;
     font-size: 0.72em;
     font-family: var(--font-mono);
     text-transform: uppercase;
     letter-spacing: 0.06em;
     cursor: pointer;
     transition: all 0.2s;
     flex-shrink: 0;
     margin-left: auto;
     white-space: nowrap;
    }

    #rag-view-all-btn:hover {
     color: var(--fg);
     border-color: var(--border-strong);
     background: var(--bg-deep);
    }

    .rag-add-item {
     border-style: dashed;
     border-left-color: var(--accent);
    }

    .rag-add-item .history-item-content {
     color: var(--fg);
     font-weight: 500;
    }

    .rag-add-item:hover {
     border-left-color: var(--accent);
    }

    #clear-history-btn {
     background: transparent;
     color: var(--fg-faint);
     border: 1px solid var(--border);
     border-radius: var(--radius-sm);
     padding: 3px 10px;
     font-size: 0.72em;
     cursor: pointer;
     transition: all 0.2s;
     font-family: var(--font-mono);
     text-transform: uppercase;
     letter-spacing: 0.06em;
     white-space: nowrap;
    }

    #clear-history-btn:hover {
     background: var(--bg-deep);
     color: var(--danger);
     border-color: var(--danger);
    }

    #clear-history-btn:disabled {
     opacity: 0.45;
     cursor: not-allowed;
    }

    #history-content {
     display: flex;
     align-items: center;
     gap: 8px;
     flex: 1;
     min-width: 0;
     overflow: hidden;
    }

    .history-item {
     flex-shrink: 0;
     max-width: 240px;
     padding: 6px 10px;
     background: var(--bg-inset);
     border: 1px solid var(--border);
     border-radius: var(--radius-sm);
     border-left: 2px solid var(--border);
     cursor: pointer;
     transition: all 0.2s;
     overflow: hidden;
    }

    .history-item:hover {
     background: var(--bg-deep);
     border-color: var(--border-strong);
     border-left-color: var(--accent);
    }

    .history-item-content {
     color: var(--fg);
     font-size: 0.8em;
     line-height: 1.4;
     white-space: nowrap;
     overflow: hidden;
     text-overflow: ellipsis;
    }

    .history-item-time {
     color: var(--fg-muted);
     font-size: 0.7em;
     margin-top: 6px;
     font-variant-numeric: tabular-nums;
    }

    #messages::-webkit-scrollbar {
     width: 5px;
    }

    #messages::-webkit-scrollbar-track {
     background: transparent;
    }

    #messages::-webkit-scrollbar-thumb {
     background: var(--border);
     border-radius: 0;
    }

    #messages::-webkit-scrollbar-thumb:hover {
     background: var(--fg-muted);
    }

    #messages {
     flex: 1;
     min-height: 0;
     overflow-y: auto;
     margin-bottom: 16px;
     padding-right: 6px;
     display: flex;
     flex-direction: column;
     gap: 14px;
    }

    /* ===== Message Styles ===== */
    .message {
     display: block;
     padding: 14px 44px 14px 16px;
     border-radius: var(--radius-sm);
     max-width: 80%;
     word-break: break-word;
     position: relative;
     font-size: 0.92rem;
     line-height: 1.6;
     border: 1px solid var(--border);
    }

    .message.user {
     background: var(--bg-inset);
     color: var(--fg);
     align-self: flex-end;
     text-align: right;
    }

    .message.ai {
     align-self: stretch;
     max-width: none;
     background: var(--bg-raised);
     color: var(--fg);
     display: flex;
     flex-direction: column;
     border-left: 2px solid var(--border-strong);
    }

    .message.system {
     background: transparent;
     color: var(--fg-faint);
     text-align: left;
     font-size: 0.7em;
     text-transform: uppercase;
     letter-spacing: 0.08em;
     border: none;
     border-radius: 0;
     margin: 0;
     max-width: 60%;
     align-self: flex-start;
     padding: 4px 16px;
    }

    .message-content {
     flex: 1;
    }

    .message.user > strong,
    .message.ai > .message-content > strong {
     font-size: 11px;
     font-weight: 600;
     text-transform: uppercase;
     letter-spacing: 0.08em;
     color: var(--fg-faint);
     margin-right: 6px;
    }

    .message.user > strong {
     color: var(--accent);
    }

    @keyframes blink {
     0%,
     100% {
      opacity: 1;
     }
     50% {
      opacity: 0.2;
     }
    }

    @keyframes dot-square {
     0% {
      transform: translate(0, 0);
      opacity: 1;
     }
     25% {
      transform: translate(8px, 0);
      opacity: 1;
     }
     50% {
      transform: translate(8px, 8px);
      opacity: 1;
     }
     75% {
      transform: translate(0, 8px);
      opacity: 1;
     }
     100% {
      transform: translate(0, 0);
      opacity: 1;
     }
    }

    .thinking-spinner {
     position: relative;
     display: inline-block;
     width: 14px;
     height: 14px;
     margin-right: 8px;
     vertical-align: middle;
     flex-shrink: 0;
     border: 1px solid var(--border);
     border-radius: 2px;
     box-sizing: border-box;
    }

    .thinking-spinner i {
     position: absolute;
     top: 1px;
     left: 1px;
     width: 3px;
     height: 3px;
     background: var(--accent);
     border-radius: 1px;
     animation: dot-square 1.1s linear infinite;
     pointer-events: none;
    }

    .thinking-spinner i:nth-child(1) {
     animation-delay: -0s;
    }

    .thinking-spinner i:nth-child(2) {
     animation-delay: -0.2s;
     opacity: 0.7;
    }

    .thinking-spinner i:nth-child(3) {
     animation-delay: -0.4s;
     opacity: 0.4;
    }

    .thinking-spinner i:nth-child(4) {
     animation-delay: -0.6s;
     opacity: 0.2;
    }

    .loading-blink {
     animation: blink 1.1s steps(2, start) infinite;
     color: var(--accent);
    }

    .chat-image-wrap {
     margin-top: 8px;
    }

    .chat-image {
     max-width: 260px;
     max-height: 220px;
     border-radius: var(--radius-sm);
     border: 1px solid var(--border);
     cursor: pointer;
     display: block;
     text-align: left;
     margin-left: auto;
    }

    .copy-message-btn {
     position: absolute;
     top: 8px;
     right: 8px;
     width: 26px;
     height: 26px;
     display: inline-flex;
     align-items: center;
     justify-content: center;
     background: transparent;
     color: var(--fg-muted);
     border: 1px solid transparent;
     border-radius: var(--radius-sm);
     cursor: pointer;
     opacity: 0;
     transition:
      opacity 0.2s,
      color 0.2s,
      background 0.2s,
      border-color 0.2s;
    }

    .message:hover .copy-message-btn,
    .copy-message-btn:focus-visible {
     opacity: 1;
    }

    .copy-message-btn:hover {
     background: var(--bg-deep);
     color: var(--fg);
     border-color: var(--border);
    }

    .copy-message-btn.copied {
     color: var(--success);
     opacity: 1;
    }

    .copy-message-btn svg {
     width: 15px;
     height: 15px;
     pointer-events: none;
    }

    /* ===== AI Message Content ===== */
    .message.ai pre,
    .message.ai pre code {
     background: var(--bg);
     color: var(--fg);
     font-family: var(--font-mono);
     font-size: 0.92em;
     border-radius: var(--radius-sm);
     padding: 14px 16px;
     overflow-x: auto;
     margin: 10px 0;
     display: block;
     border: 1px solid var(--border);
     border-left: 2px solid var(--border-strong);
    }

    .message.ai code {
     background: var(--bg-inset);
     color: var(--info);
     font-family: var(--font-mono);
     font-size: 0.92em;
     border-radius: var(--radius-sm);
     padding: 2px 6px;
     border: 1px solid var(--border);
    }

    .message.ai strong {
     color: var(--fg);
     font-weight: 600;
    }

    .message.ai em {
     color: var(--fg-muted);
     font-style: italic;
    }

    /* ===== Related Indicator ===== */
    .related-indicator-section {
     margin-bottom: 8px;
     padding-bottom: 8px;
     border-bottom: 1px dashed var(--border);
     display: flex;
     justify-content: flex-end;
    }

    .related-indicator {
     font-size: 0.68em;
     font-weight: 500;
     text-transform: uppercase;
     letter-spacing: 0.08em;
     transition: all 0.2s ease;
     display: inline-flex;
     align-items: center;
     gap: 6px;
    }

    .related-indicator::after {
     content: '';
     width: 7px;
     height: 7px;
     border-radius: 50%;
     transition: all 0.3s ease;
     background-color: transparent;
     border: 1px solid currentColor;
    }

    .related-indicator.related {
     color: var(--success);
    }

    .related-indicator.related::after {
     background-color: var(--success);
     border-color: var(--success);
    }

    .related-indicator.unrelated {
     color: var(--danger);
    }

    .related-indicator.unrelated::after {
     background-color: var(--danger);
     border-color: var(--danger);
    }

    /* ===== Token Usage ===== */
    .token-usage-section {
     margin-top: 8px;
     padding-top: 8px;
     border-top: 1px dashed var(--border);
     display: flex;
     justify-content: flex-end;
     font-size: 0.7em;
     color: var(--fg-muted);
    }

    .token-usage {
     display: inline-flex;
     align-items: center;
     gap: 12px;
    }

    .token-usage-item {
     display: inline-flex;
     align-items: center;
     gap: 4px;
    }

    .token-usage-label {
     color: var(--fg-faint);
     text-transform: uppercase;
     letter-spacing: 0.06em;
     font-size: 10px;
    }

    .token-usage-value {
     color: var(--fg);
     font-weight: 500;
     font-variant-numeric: tabular-nums;
    }

    #token-usage-header {
     display: flex;
     align-items: center;
     justify-content: space-between;
     gap: 12px;
     margin-bottom: 16px;
     padding: 10px 14px;
     background: var(--bg-inset);
     border: 1px solid var(--border);
     border-radius: var(--radius-sm);
     font-size: 0.7em;
    }

    .token-usage-header-label {
     color: var(--fg-faint);
     font-weight: 500;
     text-transform: uppercase;
     letter-spacing: 0.08em;
     font-size: 11px;
    }

    .token-usage-header-label::before {
     content: 'SESSION · ';
     color: var(--accent);
     font-weight: 600;
    }

    #token-usage-header-values {
     color: var(--fg);
     font-weight: 500;
     white-space: nowrap;
     font-variant-numeric: tabular-nums;
    }

    .timing-section {
     margin-top: 8px;
     padding-top: 8px;
     border-top: 1px dashed var(--border);
     display: flex;
     justify-content: flex-end;
     font-size: 0.68em;
     color: var(--fg-muted);
    }

    .timing {
     display: inline-flex;
     align-items: center;
     gap: 12px;
     font-variant-numeric: tabular-nums;
    }

    .timing-item {
     display: inline-flex;
     align-items: center;
     gap: 4px;
    }

    .timing-label {
     color: var(--fg-faint);
     text-transform: uppercase;
     letter-spacing: 0.06em;
     font-size: 10px;
    }

    .timing-value {
     color: var(--fg);
     font-weight: 500;
    }

    .timing-with-token-usage {
     margin-top: 4px;
     padding-top: 4px;
     border-top: none;
    }

    /* ===== Drop Overlay ===== */
    #drop-overlay {
     position: absolute;
     inset: 0;
     display: none;
     align-items: center;
     justify-content: center;
     background: rgba(10, 10, 10, 0.92);
     color: var(--fg);
     font-size: 0.85em;
     letter-spacing: 0.12em;
     text-transform: uppercase;
     border-radius: var(--radius);
     border: 1px dashed var(--border-strong);
     z-index: 10;
     pointer-events: none;
    }

    #drop-overlay.active {
     display: flex;
    }

    /* ===== Model / Loaded Panels ===== */
    #models-panel {
     flex-shrink: 0;
     min-width: 0;
     background: var(--bg-raised);
     border-radius: var(--radius);
     border: 1px solid var(--border);
     display: flex;
     align-items: center;
     gap: 14px;
     margin: 0 24px 14px;
     padding: 10px 16px;
     overflow: hidden;
    }

    .model-selector-label {
     color: var(--fg);
     font-size: 11px;
     text-transform: uppercase;
     letter-spacing: 0.12em;
     font-weight: 500;
     flex-shrink: 0;
     white-space: nowrap;
    }

    .model-selector-label .label-index {
     display: none;
    }

    #model-selector {
     display: flex;
     align-items: center;
     gap: 8px;
     flex: 1;
     min-width: 0;
     overflow: hidden;
    }

    #model-view-all-btn {
     background: transparent;
     color: var(--fg-muted);
     border: 1px solid var(--border);
     border-radius: var(--radius-sm);
     padding: 4px 10px;
     font-size: 0.72em;
     font-family: var(--font-mono);
     text-transform: uppercase;
     letter-spacing: 0.06em;
     cursor: pointer;
     transition: all 0.2s;
     flex-shrink: 0;
     margin-left: auto;
     white-space: nowrap;
    }

    #model-view-all-btn:hover {
     color: var(--fg);
     border-color: var(--border-strong);
     background: var(--bg-deep);
    }

.model-row {
     display: inline-flex;
     flex-direction: row;
     align-items: center;
     gap: 10px;
     padding: 6px 8px;
     background: var(--bg);
     border: 1px solid var(--border);
     border-radius: var(--radius-sm);
    }

    .model-row-top {
     display: flex;
     align-items: center;
     gap: 10px;
    }

     .model-row:hover {
      border-color: var(--border-strong);
     }

     .model-default-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      user-select: none;
     }

     .model-default-toggle input {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
     }

     .model-default-box {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 14px;
      height: 14px;
      background: var(--bg-inset);
      border: 1px solid var(--border);
      border-radius: 3px;
      flex-shrink: 0;
      transition: all 0.2s;
     }

     .model-default-box::after {
      content: '';
      width: 6px;
      height: 6px;
      background: var(--on-accent);
      border-radius: 1px;
      opacity: 0;
      transform: scale(0.4);
      transition: all 0.15s ease;
     }

     .model-default-toggle input:checked + .model-default-box {
      background: var(--accent);
      border-color: var(--accent);
     }

     .model-default-toggle input:checked + .model-default-box::after {
      opacity: 1;
      transform: scale(1);
     }

     .model-default-toggle input:focus-visible + .model-default-box {
      box-shadow: 0 0 0 1px var(--accent);
     }

     .model-default-label {
      color: var(--fg-faint);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      white-space: nowrap;
     }

    .model-btn {
     background: transparent;
     color: var(--fg-muted);
     border: 1px solid var(--border);
     border-radius: var(--radius-sm);
     padding: 6px 14px;
     font-size: 0.8em;
     cursor: pointer;
     transition: all 0.2s;
     outline: none;
     font-family: var(--font-mono);
    }

    .model-btn:hover {
     background: var(--bg-deep);
     color: var(--fg);
     border-color: var(--border-strong);
    }

    .model-btn[aria-pressed='true'] {
     background: var(--accent);
     color: var(--on-accent);
     border-color: var(--accent);
     font-weight: 500;
    }

    .model-btn:focus-visible {
     outline: 1px solid var(--accent);
     outline-offset: 2px;
    }

    #loaded-models {
     display: none;
    }

    .model-row.loaded {
     background: var(--bg-inset);
     border-color: var(--border-strong);
     border-left: 2px solid var(--accent);
    }

    .model-row.loaded .model-btn {
     color: var(--fg);
     border-color: var(--border-strong);
     background: var(--bg-deep);
    }

    .model-unload-btn {
     display: none;
     align-items: center;
     justify-content: center;
     padding: 3px 10px;
     background: transparent;
     color: var(--fg-muted);
     border: 1px solid var(--border);
     border-radius: var(--radius-sm);
     cursor: pointer;
     font-size: 0.72em;
     font-family: var(--font-mono);
     text-transform: uppercase;
     letter-spacing: 0.06em;
     transition: all 0.2s;
    }

    .model-row.loaded .model-unload-btn {
     display: flex;
    }

    .model-unload-btn:hover:not(:disabled) {
     color: var(--danger);
     border-color: var(--danger);
     background: var(--bg-deep);
    }

.model-unload-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
     }

     /* ===== Model Sheet ===== */
     #model-sheet-overlay {
      position: fixed;
      inset: 0;
      z-index: 900;
      display: flex;
      justify-content: flex-end;
      background: rgba(0, 0, 0, 0.55);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
     }

     #model-sheet-overlay[hidden] {
      display: none;
     }

     #model-sheet-overlay.open {
      opacity: 1;
      pointer-events: auto;
     }

     .model-sheet {
      width: min(400px, 100%);
      height: 100%;
      background: var(--bg-raised);
      border-left: 1px solid var(--border-strong);
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.25s ease;
      box-shadow: -12px 0 40px rgba(0, 0, 0, 0.5);
     }

     #model-sheet-overlay.open .model-sheet {
      transform: translateX(0);
     }

     .model-sheet-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 18px 16px 14px;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
     }

     .model-sheet-title {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--fg);
     }

     .model-sheet-count {
      margin-left: auto;
      color: var(--fg-faint);
      font-size: 0.72em;
      text-transform: uppercase;
      letter-spacing: 0.06em;
     }

     .model-sheet-close {
      background: transparent;
      border: none;
      color: var(--fg-muted);
      font-size: 1.1em;
      line-height: 1;
      padding: 4px;
      cursor: pointer;
      border-radius: var(--radius-sm);
      transition: all 0.2s;
     }

     .model-sheet-close:hover {
      color: var(--fg);
      background: var(--bg-inset);
     }

     .model-sheet-body {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
     }

     .model-sheet-body .model-row {
      width: 100%;
     }

     /* ===== History Sheet ===== */
     #history-sheet-overlay {
      position: fixed;
      inset: 0;
      z-index: 900;
      display: flex;
      justify-content: flex-end;
      background: rgba(0, 0, 0, 0.55);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
     }

     #history-sheet-overlay[hidden] {
      display: none;
     }

     #history-sheet-overlay.open {
      opacity: 1;
      pointer-events: auto;
     }

     .history-sheet {
      width: min(420px, 100%);
      height: 100%;
      background: var(--bg-raised);
      border-left: 1px solid var(--border-strong);
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.25s ease;
      box-shadow: -12px 0 40px rgba(0, 0, 0, 0.5);
     }

     #history-sheet-overlay.open .history-sheet {
      transform: translateX(0);
     }

     .history-sheet-header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 18px 16px 14px;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
     }

     .history-sheet-title {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--fg);
     }

     .history-sheet-count {
      margin-left: auto;
      color: var(--fg-faint);
      font-size: 0.72em;
      text-transform: uppercase;
      letter-spacing: 0.06em;
     }

     .history-sheet-close {
      background: transparent;
      border: none;
      color: var(--fg-muted);
      font-size: 1.1em;
      line-height: 1;
      padding: 4px;
      cursor: pointer;
      border-radius: var(--radius-sm);
      transition: all 0.2s;
     }

     .history-sheet-close:hover {
      color: var(--fg);
      background: var(--bg-inset);
     }

     .history-sheet-clear {
      background: transparent;
      color: var(--fg-faint);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 3px 10px;
      font-size: 0.72em;
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      cursor: pointer;
      transition: all 0.2s;
      flex-shrink: 0;
      white-space: nowrap;
     }

     .history-sheet-clear:hover {
      background: var(--bg-deep);
      color: var(--danger);
      border-color: var(--danger);
     }

     .history-sheet-body {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
     }

     .history-sheet-body::-webkit-scrollbar {
      width: 5px;
     }

     .history-sheet-body::-webkit-scrollbar-track {
      background: transparent;
     }

     .history-sheet-body::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 0;
     }

     .history-sheet-body::-webkit-scrollbar-thumb:hover {
      background: var(--fg-muted);
     }

     .history-sheet-body .history-item {
      width: 100%;
      max-width: none;
      flex-shrink: 1;
     }

     .history-sheet-body .history-item-content {
      white-space: normal;
      word-break: break-word;
     }

     /* ===== RAG Files Modal ===== */
     .rag-files-dialog {
      width: min(540px, calc(100vw - 48px));
      display: flex;
      flex-direction: column;
     }

     .rag-files-dialog.dragover {
      border-color: var(--accent);
     }

     .rag-files-body {
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 14px;
     }

     .rag-upload-row {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
     }

     #rag-file-input {
      flex: 1;
      min-width: 0;
      color: var(--fg);
      font-family: var(--font-mono);
      font-size: 0.78em;
     }

     #rag-file-input::file-selector-button {
      background: var(--bg-deep);
      color: var(--fg);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      padding: 6px 12px;
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.72em;
      cursor: pointer;
      margin-right: 10px;
     }

     #rag-files-upload-btn {
      background: var(--accent);
      color: var(--on-accent);
      border: 1px solid var(--accent);
      border-radius: var(--radius-sm);
      padding: 7px 14px;
      font-size: 0.74em;
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      transition: all 0.2s;
      flex-shrink: 0;
      white-space: nowrap;
     }

     #rag-files-upload-btn:hover {
      opacity: 0.88;
     }

     #rag-files-upload-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
     }

     .rag-drop-hint {
      flex-basis: 100%;
      color: var(--fg-faint);
      font-size: 0.7em;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      user-select: none;
     }

     .rag-files-list {
      max-height: 45vh;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding-right: 6px;
     }

     .rag-files-list::-webkit-scrollbar {
      width: 5px;
     }

     .rag-files-list::-webkit-scrollbar-track {
      background: transparent;
     }

     .rag-files-list::-webkit-scrollbar-thumb {
      background: var(--border);
     }

     .rag-files-list .history-item {
      width: 100%;
      max-width: none;
      flex-shrink: 1;
     }

     .rag-files-list .history-item-content {
      white-space: normal;
      word-break: break-word;
     }

     .modal-count {
      margin-left: auto;
      color: var(--fg-faint);
      font-size: 0.72em;
      text-transform: uppercase;
      letter-spacing: 0.06em;
     }

     /* ===== Input ===== */
    #input-form {
     display: flex;
     flex-direction: column;
     gap: 10px;
     margin-top: 14px;
    }

    .input-shell {
     display: flex;
     align-items: center;
     gap: 10px;
     background: var(--bg-inset);
     border: 1px solid var(--border);
     border-radius: var(--radius-sm);
     padding: 0 14px;
     transition: border-color 0.2s, box-shadow 0.2s;
    }

     .input-shell:focus-within {
      border-color: var(--border-strong);
      box-shadow: inset 0 0 0 1px var(--accent);
     }

     #input-attachments {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
     }

     #input-attachments:empty {
      display: none;
     }

     .attachment-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 4px 6px 4px 4px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-size: 0.76em;
      max-width: 220px;
     }

     .attachment-chip-preview {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      object-fit: cover;
      flex-shrink: 0;
      background: var(--bg-inset);
     }

     .attachment-chip-preview.file {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7em;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--fg-muted);
     }

     .attachment-chip-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
     }

     .attachment-chip-name {
      color: var(--fg);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
     }

     .attachment-chip-remove {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      padding: 0;
      background: transparent;
      color: var(--fg-muted);
      border: 1px solid transparent;
      border-radius: var(--radius-sm);
      cursor: pointer;
      font-size: 1em;
      line-height: 1;
      flex-shrink: 0;
      transition: all 0.2s;
     }

     .attachment-chip-remove:hover {
      color: var(--danger);
      background: var(--bg-deep);
      border-color: var(--border);
     }

     .attachment-chip.uploading {
      border-color: var(--accent-soft);
     }

     .attachment-chip.error {
      border-color: var(--danger);
      color: var(--danger);
     }

     .attachment-chip-status {
      font-size: 0.72em;
      color: var(--fg-muted);
      white-space: nowrap;
     }

     .attachment-chip-status.uploading::before {
      content: '⏳ ';
     }

     .attachment-chip-status.error {
      color: var(--danger);
     }

    .prompt-marker {
     color: var(--accent);
     font-size: 1.05em;
     user-select: none;
    }

    #input {
     flex: 1;
     background: transparent;
     border: none;
     color: var(--fg);
     font-family: var(--font-mono);
     font-size: 0.92em;
     padding: 12px 0;
     outline: none;
     caret-color: var(--accent);
    }

    #input::placeholder {
     color: var(--fg-muted);
     opacity: 0.7;
    }

    .speak-btn {
     display: inline-flex;
     align-items: center;
     justify-content: center;
     width: 30px;
     height: 30px;
     padding: 0;
     flex-shrink: 0;
     background: transparent;
     color: var(--fg-muted);
     border: 1px solid transparent;
     border-radius: var(--radius-sm);
     cursor: pointer;
     transition: all 0.2s;
    }

    .speak-btn:hover:not(:disabled) {
     color: var(--fg);
     background: var(--bg-deep);
     border-color: var(--border);
    }

    .speak-btn:disabled {
     opacity: 0.45;
     cursor: not-allowed;
    }

    .speak-btn svg {
     width: 16px;
     height: 16px;
     pointer-events: none;
    }

    .speak-btn .icon-stop {
     display: none;
    }

    .speak-btn.playing {
     color: var(--danger);
     border-color: var(--border);
    }

    .speak-btn.playing .icon-speak {
     display: none;
    }

    .speak-btn.playing .icon-stop {
     display: block;
    }

    .input-controls {
     display: flex;
     flex-wrap: wrap;
     align-items: center;
     gap: 10px;
    }

    /* ===== Buttons ===== */
    #send,
    #stop-stream,
    #upload-btn,
    #new-chat-btn {
     border-radius: var(--radius-sm);
     padding: 9px 18px;
     font-size: 0.82em;
     cursor: pointer;
     transition: all 0.2s;
     white-space: nowrap;
     font-family: var(--font-mono);
     text-transform: uppercase;
     letter-spacing: 0.06em;
    }

    #send {
     background: var(--accent);
     color: var(--on-accent);
     border: 1px solid var(--accent);
     font-weight: 600;
    }

    #send:hover {
     opacity: 0.88;
    }

    #stop-stream,
    #upload-btn,
    #new-chat-btn {
     background: transparent;
     color: var(--fg);
     border: 1px solid var(--border);
    }

    #stop-stream:hover:not(:disabled),
    #upload-btn:hover:not(:disabled),
    #new-chat-btn:hover {
     background: var(--bg-inset);
     color: var(--fg);
     border-color: var(--border-strong);
    }

    #stop-stream:disabled,
    #upload-btn:disabled {
     opacity: 0.45;
     cursor: not-allowed;
    }

    /* ===== Streaming Toggle ===== */
    .streaming-toggle-container {
     display: flex;
     align-items: center;
     margin-right: auto;
    }

    .streaming-toggle-label {
     display: flex;
     align-items: center;
     gap: 8px;
     font-size: 0.76em;
     color: var(--fg-muted);
     cursor: pointer;
     text-transform: uppercase;
     letter-spacing: 0.06em;
     user-select: none;
    }

    .streaming-toggle-wrapper {
     position: relative;
     display: inline-block;
     width: 44px;
     height: 20px;
    }

    .streaming-toggle-input {
     opacity: 0;
     width: 0;
     height: 0;
     position: absolute;
    }

    .streaming-toggle-track {
     position: absolute;
     cursor: pointer;
     top: 0;
     left: 0;
     right: 0;
     bottom: 0;
     background-color: var(--bg-deep);
     border: 1px solid var(--border);
     border-radius: 5px;
     transition: all 0.2s ease;
    }

    .streaming-toggle-thumb {
     position: absolute;
     left: 2px;
     top: 2px;
     width: 14px;
     height: 14px;
     background: var(--fg-muted);
     border-radius: 2px;
     transition: transform 0.2s ease, background 0.2s ease;
    }

    .streaming-toggle-input:checked + .streaming-toggle-track {
     border-color: var(--accent);
    }

    .streaming-toggle-input:checked + .streaming-toggle-track + .streaming-toggle-thumb {
     transform: translateX(24px);
     background: var(--accent);
    }

    .streaming-toggle-input:focus-visible + .streaming-toggle-track {
     box-shadow: 0 0 0 1px var(--accent);
    }

    /* ===== Confirmation Modal ===== */
     .modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.6);
      animation: modal-fade-in 0.15s ease-out;
     }

     .modal-overlay[hidden] {
      display: none;
     }

     .modal-dialog {
      width: min(420px, calc(100vw - 48px));
      background: var(--bg-raised);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
     }

     .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
     }

     .modal-title {
      font-size: 0.85em;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
     }

     .modal-close {
      background: transparent;
      border: none;
      color: var(--fg-muted);
      font-size: 1.1em;
      line-height: 1;
      padding: 4px;
      cursor: pointer;
      border-radius: var(--radius-sm);
      transition: all 0.2s;
     }

     .modal-close:hover {
      color: var(--fg);
      background: var(--bg-inset);
     }

     .modal-body {
      padding: 18px 16px;
      font-size: 0.85em;
      line-height: 1.5;
      color: var(--fg);
     }

     .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      padding: 12px 16px;
      border-top: 1px solid var(--border);
     }

     .modal-btn {
      background: transparent;
      color: var(--fg);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius-sm);
      padding: 6px 14px;
      font-size: 0.78em;
      font-family: var(--font-mono);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      cursor: pointer;
      transition: all 0.2s;
     }

     .modal-btn:hover {
      background: var(--bg-inset);
      border-color: var(--fg-muted);
     }

     .modal-btn.danger {
      border-color: var(--danger);
      color: var(--danger);
     }

     .modal-btn.danger:hover {
      background: var(--danger);
      color: var(--on-accent);
     }

     @keyframes modal-fade-in {
      from {
       opacity: 0;
      }
      to {
       opacity: 1;
      }
     }
    </style>
  </head>
 <body>
   <header class="app-header">
    <div class="app-header-inner">
     <div class="app-brand">
      <span class="app-wordmark">ChatAI</span>
      <span class="app-sub">session console</span>
     </div>
