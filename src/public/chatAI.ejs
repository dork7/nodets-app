     try {
      const res = await fetch(`${CONFIG.RAG_API_URL}/file/${encodeURIComponent(file.id)}`, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) {
       messageManager.append(
        'System',
        `Removed "${this.displayName(file)}" from the vector DB (${result.responseObject?.removed ?? 0} chunks).`,
        'system'
       );
       await this.loadFiles();
      } else {
       this.openErrorPopup(`Failed to remove "${this.displayName(file)}" from the vector DB: ${result.message}`);
      }
     } catch (error) {
      this.openErrorPopup(`Failed to remove "${this.displayName(file)}" from the vector DB.`);
     } finally {
      if (btn) {
       btn.disabled = false;
       btn.textContent = originalText;
