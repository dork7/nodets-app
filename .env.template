# Environment Configuration
NODE_ENV="development"
PORT="2020"
HOST="localhost"
ENV="local"

# CORS Settings
CORS_ORIGIN="http://localhost:*"

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="1000"
COMMON_RATE_LIMIT_MAX_REQUESTS="2000"

# API
API_VERSION="v1"
BASE_URL=""
CLIENT_ID=""
PRODUCTS_API="https://dummyjson.com/products"

# MongoDB
MONGO_URI="mongodb://localhost:27017/test"
MONGO_URI_LOCAL="mongodb://localhost:27017/test"
MONGO_URI_TESTS="mongodb://localhost:27017/test"
MONGO_URI_TESTS_LOCAL="mongodb://localhost:27017/test"

# Kafka
KAFKA_BROKER="localhost:9092"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# OpenAI
OPENAI_API_KEY=""

# Vision (image analysis) provider - OpenAI-compatible free cloud models
VISION_BASE_URL="https://openrouter.ai/api/v1"
VISION_API_KEY=""
LOCALAI_IMAGE_ANALYSIS_MODEL="google/gemma-4-26b-a4b-it:free"

# Chat (/ai/chat) default models
LOCALAI_CHAT_MODEL="ai/gemma3"
OPENROUTER_CHAT_MODEL="google/gemma-4-26b-a4b-it:free"

# Slack
SLACK_CHANNEL=""
SLACK_TOKEN=""

# AI Models
AI_MODELS="ai/gemma3,ai/mistral,ai/smollm2"
 
ENABLE_FILE_LOGGING=true

MINIO_ACCESS_KEY=admin123
MINIO_SECRET_KEY=admin123
MINIO_PORT=9000
MINIO_ENDPOINT=localhost

# RAG
CHROMA_URL=http://localhost:8000
RAG_COLLECTION_NAME=knowledge_base
RAG_ENABLED=false
RAG_TOP_K=3
OCR_ENABLED=true
OCR_LANGS=eng
CHAT_HISTORY_COMPACT_THRESHOLD_CHARS=12000
CHAT_HISTORY_KEEP_RECENT=6

# Qdrant / LlamaIndex
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=llama_index_documents
# Bare host for Ollama (`ollama serve`, default port 11434) - the OpenAI client
# appends /v1 itself; other consumers append their own paths to this root.
# Model names above (LOCALAI_CHAT_MODEL, LOCALAI_IMAGE_ANALYSIS_MODEL, etc.)
# must match tags from `ollama list`, e.g. "llama3.1", "qwen2.5:32b".
LOCALAI_URL=http://localhost:11434
LOCALAI_EMBEDDING_MODEL=nemotron-3-embed-1b-q4

# Ollama - registered as its own "ollama" provider alongside "localAI" above
# (both can point at the same `ollama serve` instance, or different hosts).
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:0.5b

# LangChain RAG pipeline (/v1/ingest, /v1/retrieve) - reuses QDRANT_*, MONGO_URI
# and OPENROUTER_EMBED_MODEL above. Run `npm run rag:bootstrap` once, and
# `npm run rag:worker` alongside the API to process ingestion jobs.
ANTHROPIC_API_KEY=
# Optional: reranking is skipped when empty.
VOYAGE_API_KEY=
RAG_ANSWER_MODEL=claude-opus-5-5
RAG_VERIFIER_MODEL=claude-opus-5-5
RAG_VISION_MODEL=claude-opus-5-5
RAG_UTILITY_MODEL=claude-opus-5-5
# Must match the vector size of OPENROUTER_EMBED_MODEL.
RAG_EMBEDDING_DIM=1536
RAG_RERANK_MODEL=rerank-2.5
RAG_QDRANT_COLLECTION=rag_chunks
RAG_CHUNK_CHARS=3200
RAG_CHUNK_OVERLAP_CHARS=400
RAG_RETRIEVE_K=20
RAG_RERANK_TOP_K=8
RAG_MAX_ATTEMPTS=3
RAG_MAX_UPLOAD_MB=50
RAG_IMAGE_MAX_EDGE=2000
# vision | text
RAG_PDF_EXTRACT_MODE=vision
RAG_PDF_PAGES_PER_CALL=5
RAG_WORKER_CONCURRENCY=2
RAG_JOB_LOCK_TIMEOUT_MS=900000
RAG_MAX_JOB_ATTEMPTS=3
# 0 = keep forever
RAG_LOG_RETENTION_DAYS=180
RAG_LOG_STORE_ANSWERS=true
# Sharing ingested content with "*" or other users; keep false until callers are authenticated.
RAG_ALLOW_SHARED_ACL=false
RAG_RETRIEVE_TIMEOUT_MS=120000
# LangChain traces prompts to LangSmith when this is true; keep it off unless that is acceptable.
LANGSMITH_TRACING=false
