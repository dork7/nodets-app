# Environment Configuration
NODE_ENV="development"
PORT="2020"
HOST="localhost"
ENV="local"

# CORS Settings
CORS_ORIGIN="http://localhost:*"

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="1000"
COMMON_RATE_LIMIT_MAX_REQUESTS="2000"

# API
API_VERSION="v1"
BASE_URL=""
CLIENT_ID=""
PRODUCTS_API="https://dummyjson.com/products"

# MongoDB
MONGO_URI="mongodb://localhost:27017/test"
MONGO_URI_LOCAL="mongodb://localhost:27017/test"
MONGO_URI_TESTS="mongodb://localhost:27017/test"
MONGO_URI_TESTS_LOCAL="mongodb://localhost:27017/test"

# Kafka
KAFKA_BROKER="localhost:9092"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"

# OpenAI
OPENAI_API_KEY=""

# Vision (image analysis) provider - OpenAI-compatible free cloud models
VISION_BASE_URL="https://openrouter.ai/api/v1"
VISION_API_KEY=""
LOCALAI_IMAGE_ANALYSIS_MODEL="google/gemma-4-26b-a4b-it:free"

# Chat (/ai/chat) default models
LOCALAI_CHAT_MODEL="ai/gemma3"
OPENROUTER_CHAT_MODEL="google/gemma-4-26b-a4b-it:free"

# Slack
SLACK_CHANNEL=""
SLACK_TOKEN=""

# AI Models
AI_MODELS="ai/gemma3,ai/mistral,ai/smollm2"
 
ENABLE_FILE_LOGGING=true

MINIO_ACCESS_KEY=admin123
MINIO_SECRET_KEY=admin123
MINIO_PORT=9000
MINIO_ENDPOINT=localhost

# RAG
CHROMA_URL=http://localhost:8000
RAG_COLLECTION_NAME=knowledge_base
RAG_ENABLED=false
RAG_TOP_K=3
# Bare host for Ollama (`ollama serve`, default port 11434) - the OpenAI client
# appends /v1 itself; other consumers append their own paths to this root.
# Model names above (LOCALAI_CHAT_MODEL, LOCALAI_IMAGE_ANALYSIS_MODEL, etc.)
# must match tags from `ollama list`, e.g. "llama3.1", "qwen2.5:32b".
LOCALAI_URL=http://localhost:11434
LOCALAI_EMBEDDING_MODEL=nemotron-3-embed-1b-q4

# Google Sign-In / Drive integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:2020/v1/auth/google/callback"
GOOGLE_DRIVE_SCOPES="openid email profile https://www.googleapis.com/auth/drive"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
SESSION_SECRET=""
# Ollama - registered as its own "ollama" provider alongside "localAI" above
# (both can point at the same `ollama serve` instance, or different hosts).
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:0.5b
